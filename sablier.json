{
  "project": "Sablier",
  "expiry_year": 2035,
  "default_lifetime_years": 3,
  "exclude": [
    "src/Detector/*",
    "src/Probe.php",
    "src/Catalogue.php",
    "translations/*",
    "tests/fixtures/*",
    "tests/run.sh",
    "docs/*",
    "README.md"
  ],
  "domains": {
    "report signatures": {
      "paths": ["src/Signature.php"],
      "lifetime_years": 1,
      "note": "A report is presented within the quarter. Put 15 here if you archive for a regulator: the verdict changes, and that is the point."
    }
  }
}
