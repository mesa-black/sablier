# Static analysis at the strictest level the tool offers.
#
# Run from a container rather than from a vendor directory: this project ships
# no dependencies, and a QA tool is not a reason to start.
#
#   make phpstan
parameters:
	level: max
	# Every version the tool supports: 8.4, the minimum users may have, to 8.5,
	# the one the launcher's image runs.
	phpVersion:
		min: 80400
		max: 80500
	paths:
		- bin/sablier
		- src
	excludePaths:
		- tests/fixtures/*
