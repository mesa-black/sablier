#!/usr/bin/env php
<?php

/*
 * Sablier — cryptographic inventory, and the expiry date of each protection.
 *
 *   bin/sablier scan <path> [--declare=sablier.json] [--out=report.html] [--pdf=report.pdf]
 *   bin/sablier judge <cbom.json>
 *   bin/sablier probe <host>
 *
 * No dependency, no network call of its own, no telemetry. On a tool that reads
 * where the keys are, that is not a posture: every dependency would be one more
 * supply chain to defend.
 */

declare(strict_types=1);

// A four-line autoloader rather than a require list that has to be kept in
// order: adding a detector must not mean editing this file.
spl_autoload_register(static function (string $class): void {
    if (str_starts_with($class, 'Sablier\\')) {
        $path = __DIR__.'/../src/'.str_replace('\\', '/', substr($class, 8)).'.php';
        if (is_file($path)) {
            require $path;
        }
    }
});

// This file is a script, not a library: it stays in the global namespace and
// imports what it uses. A namespace declaration cannot legally follow the
// shebang line anyway — PHP tolerates it, the specification does not, and an
// entry point that makes an editor shout is a poor advertisement for a tool
// that spends its time telling people what is wrong with their code.
use Sablier\Advisories;
use Sablier\Airgap;
use Sablier\Analysis;
use Sablier\Assessor;
use Sablier\Baseline;
use Sablier\Catalogue;
use Sablier\Crossings;
use Sablier\Cbom;
use Sablier\Declaration;
use Sablier\Docker;
use Sablier\Detector\AssetDetector;
use Sablier\Detector\DependencyDetector;
use Sablier\Detector\EnvDetector;
use Sablier\Detector\FrameworkConfigDetector;
use Sablier\Detector\KeyMaterialDetector;
use Sablier\Detector\PhpDetector;
use Sablier\Detector\ServerConfigDetector;
use Sablier\Detector\ShellDetector;
use Sablier\Detector\SshConfigDetector;
use Sablier\Detector\SymfonyVaultDetector;
use Sablier\Detector\TerraformDetector;
use Sablier\Finding;
use Sablier\Interview;
use Sablier\Lang;
use Sablier\MlDsa;
use Sablier\Pdf;
use Sablier\Probe;
use Sablier\Worksheet;
use Sablier\Reporter\AuditReporter;
use Sablier\Reporter\CbomReporter;
use Sablier\Reporter\HtmlReporter;
use Sablier\Reporter\JsonReporter;
use Sablier\Scanner;
use Sablier\Signature;
use Sablier\Value;
use Sablier\Version;
use Sablier\Web\Session;

// Arguments are read through the same door as every other outside value: a
// list of strings, whatever the runtime put in $_SERVER.
/** @var list<string> $argv */
$argv = array_values(array_map(
    static fn (mixed $argument): string => Value::string($argument),
    Value::map($_SERVER['argv'] ?? null),
));
$command = $argv[1] ?? 'help';

// Language is read before anything else: the help text is translated too.
Lang::use(getenv('SABLIER_LANG') ?: 'fr');
foreach ($argv as $arg) {
    if (preg_match('/^--lang=(\w+)$/', $arg, $m) === 1) {
        Lang::use($m[1]);
    } elseif ($arg === '--airgap') {
        Airgap::enable();
    }
}

if ($command === '--version' || $command === 'version') {
    printf("%s\n", Version::label());
    exit(0);
}

/**
 * Every detector, in one place.
 *
 * Four commands walk a project — scan, declare, serve and worksheet — and a
 * detector added to three of them is a detector that silently does not exist in
 * the fourth.
 */
function sablier_scanner(Declaration $declaration): Scanner
{
    return new Scanner([
        new PhpDetector(),
        new ShellDetector(),
        new KeyMaterialDetector(),
        new AssetDetector(),
        new ServerConfigDetector(),
        new SshConfigDetector(),
        new EnvDetector(),
        new FrameworkConfigDetector(),
        new SymfonyVaultDetector(),
        new DependencyDetector(),
        new TerraformDetector(),
    ], $declaration->exclude);
}

// --- keys and verification ---------------------------------------------
if ($command === 'keygen') {
    $out = 'sablier.key';
    foreach (\array_slice($argv, 2) as $arg) {
        if (preg_match('/^--out=(.+)$/', $arg, $m) === 1) {
            $out = $m[1];
        }
    }
    if (is_file($out)) {
        fwrite(\STDERR, '✗ '.Lang::t('cli.key_exists', $out)."\n");
        exit(1);
    }

    $pair = Signature::keypair();
    file_put_contents($out, $pair['secret']."\n");
    chmod($out, 0600);

    printf("  %s\n\n    \"signing_public_key\": \"%s\"\n\n  %s\n", Lang::t('cli.key_written', $out), $pair['public'], Lang::t('cli.key_next'));

    // The post-quantum half, beside the other one, when this machine can make
    // it. Written here rather than asked for: a second flag to remember is a
    // second flag nobody passes.
    $hybrid = MlDsa::keypair();
    if ($hybrid !== null) {
        $hybridPath = Signature::hybridKeyPath($out);
        file_put_contents($hybridPath, $hybrid['secret']);
        chmod($hybridPath, 0600);
        printf("\n  %s\n\n    \"signing_public_key_pq\": %s\n", Lang::t('cli.key_hybrid', MlDsa::ALGORITHM, $hybridPath), json_encode($hybrid['public'], \JSON_UNESCAPED_SLASHES));
    } else {
        printf("\n  %s\n", Lang::t('cli.key_hybrid.absent', MlDsa::ALGORITHM));
    }
    exit(0);
}

if ($command === 'verify') {
    $signaturePath = $argv[2] ?? '';
    $declarePath = null;
    $claimed = '';
    foreach (\array_slice($argv, 3) as $arg) {
        if (preg_match('/^--declare=(.+)$/', $arg, $m) === 1) {
            $declarePath = $m[1];
        } elseif (preg_match('/^--fingerprint=(.+)$/', $arg, $m) === 1) {
            $claimed = $m[1];
        }
    }
    if (!is_file($signaturePath)) {
        fwrite(\STDERR, '✗ '.Lang::t('cli.verify_usage')."\n");
        exit(1);
    }

    $block = Value::map(json_decode((string) file_get_contents($signaturePath), true));
    $declaration = $declarePath !== null ? Declaration::load($declarePath) : null;
    $expectedKey = $declaration?->signingPublicKey;
    $expectedPqKey = $declaration?->signingPublicKeyPq;
    $previous = Value::string($block['previous'] ?? null);
    /** @var array<string, mixed> $hybridClaim */
    $hybridClaim = Value::map($block['hybrid'] ?? null);
    $result = Signature::verify([
        'algorithm' => Value::string($block['algorithm'] ?? null),
        'digest' => Value::string($block['digest'] ?? null),
        'signed_at' => Value::string($block['signed_at'] ?? null),
        'public_key' => Value::string($block['public_key'] ?? null),
        'signature' => Value::string($block['signature'] ?? null),
        'previous' => $previous,
        'hybrid' => $hybridClaim,
    ], null, $expectedKey, $expectedPqKey);

    printf("  %s\n", Lang::t($result['reason']));

    // The keys in this file against the line that came by another road. With an
    // ephemeral key there is nothing else to compare them to: the channel is
    // what proves who signed, and this is where the two meet.
    if ($claimed !== '') {
        $actual = Signature::fingerprint(
            Value::string($block['public_key'] ?? null),
            Value::string($hybridClaim['public_key'] ?? null),
        );
        $normalise = static fn (string $v): string => strtoupper((string) preg_replace('/[^0-9A-Fa-f]/', '', $v));
        $same = hash_equals($normalise($actual), $normalise($claimed));
        printf("  %s\n", Lang::t($same ? 'seal.fingerprint.match' : 'seal.fingerprint.differs', $actual));
        if (!$same) {
            exit(1);
        }
    }

    // Which signatures the file carries, and which of them this machine could
    // check. A reader who cannot run ML-DSA must know that, not guess it.
    if ($hybridClaim !== []) {
        printf("  %s\n", Lang::t(match ($result['hybrid'] ?? '') {
            'valid' => 'verify.hybrid.valid',
            'invalid' => 'verify.hybrid.invalid',
            default => 'verify.hybrid.unavailable',
        }, Value::string($hybridClaim['algorithm'] ?? null)));
    } else {
        printf("  %s\n", Lang::t('verify.hybrid.none'));
    }

    // The link, when the block claims one. Given the earlier signature, it is
    // checked; given nothing, it is still printed, because a reader holding
    // one file should know another exists.
    if ($previous !== '') {
        $earlier = null;
        foreach (\array_slice($argv, 3) as $argument) {
            if (preg_match('/^--previous=(.+)$/', $argument, $m) === 1) {
                $earlier = Signature::previousDigest($m[1]);
            }
        }

        printf("  %s\n", $earlier === null
            ? Lang::t('verify.previous', substr($previous, 0, 16))
            : Lang::t($earlier === $previous ? 'verify.previous.match' : 'verify.previous.mismatch', substr($previous, 0, 16)));
        if ($earlier !== null && $earlier !== $previous) {
            exit(1);
        }
    }

    exit($result['valid'] ? 0 : 1);
}

// --- accept a finding: bin/sablier accept <fingerprint> -----------------
// The command-line twin of the report's button. It writes a decision into a
// versioned file, which is what makes it reviewable; it never hides anything.
if ($command === 'accept') {
    $fingerprint = $argv[2] ?? '';
    $reason = '';
    $until = (new \DateTimeImmutable('+6 months'))->format('Y-m-d');
    $file = 'sablier.json';
    foreach (\array_slice($argv, 3) as $arg) {
        if (preg_match('/^--(reason|until|declare)=(.+)$/', $arg, $m) === 1) {
            ${$m[1] === 'declare' ? 'file' : $m[1]} = $m[2];
        }
    }

    if (preg_match('/^[0-9a-f]{8}$/', $fingerprint) !== 1 || trim($reason) === '') {
        fwrite(\STDERR, '✗ '.Lang::t('cli.accept_usage')."\n");
        exit(1);
    }
    if (\DateTimeImmutable::createFromFormat('Y-m-d', $until) === false) {
        fwrite(\STDERR, '✗ '.Lang::t('cli.accept_bad_date')."\n");
        exit(1);
    }

    $data = is_file($file) ? json_decode((string) file_get_contents($file), true) : [];
    if (!\is_array($data)) {
        fwrite(\STDERR, '✗ '.Lang::t('cli.accept_unreadable', $file)."\n");
        exit(1);
    }
    $accepted = Value::map($data['accepted'] ?? null);
    $accepted[$fingerprint] = ['reason' => trim($reason), 'until' => $until];
    $data['accepted'] = $accepted;
    file_put_contents($file, json_encode($data, \JSON_PRETTY_PRINT | \JSON_UNESCAPED_UNICODE | \JSON_UNESCAPED_SLASHES)."\n");

    printf("  %s\n", Lang::t('cli.accept_written', $fingerprint, $until, $file));
    exit(0);
}

// --- a declaration to correct: bin/sablier init <path> ------------------
// The starter file, copied with the two things a machine can honestly fill:
// the project's name and today's date. Everything else is a proposal to argue
// with, which is the point — correcting a draft surfaces the disagreements a
// blank file hides.
if ($command === 'init') {
    $target = $argv[2] ?? '.';
    $root = realpath($target);
    if ($root === false || !is_dir($root)) {
        fwrite(\STDERR, '✗ '.Lang::t('cli.missing_path')."\n");
        exit(1);
    }

    $out = $root.'/sablier.json';
    foreach (\array_slice($argv, 3) as $argument) {
        if (preg_match('/^--out=(.+)$/', $argument, $m) === 1) {
            $out = $m[1];
        }
    }

    // Never over a declaration that exists: it holds decisions somebody made,
    // and this command has nothing to add to them.
    if (is_file($out)) {
        fwrite(\STDERR, '✗ '.Lang::t('cli.init_exists', $out)."\n");
        exit(1);
    }

    $starter = Value::map(json_decode((string) @file_get_contents(__DIR__.'/../examples/starter.json'), true));
    if ($starter === []) {
        fwrite(\STDERR, '✗ '.Lang::t('cli.init_unreadable')."\n");
        exit(1);
    }

    $starter['project'] = basename($root);
    $starter['deadlines_checked_on'] = (new \DateTimeImmutable())->format('Y-m-d');
    file_put_contents($out, json_encode($starter, \JSON_PRETTY_PRINT | \JSON_UNESCAPED_SLASHES | \JSON_UNESCAPED_UNICODE)."\n");

    printf("\n  %s\n  %s\n\n", Lang::t('cli.init_written', $out), Lang::t('cli.init_next'));
    exit(0);
}

// --- the interview in a browser: bin/sablier serve <path> ---------------
// The terminal version works and nobody should have to use it in front of a
// client. Same questions, same file written at the end, one subject per page
// and a clock the person can see.
if ($command === 'serve') {
    $target = $argv[2] ?? '';
    $port = 8765;
    $host = '127.0.0.1';
    $out = null;
    $expose = false;
    $public = null;
    foreach (\array_slice($argv, 3) as $argument) {
        if ($argument === '--expose') {
            $expose = true;
        } elseif (preg_match('/^--out=(.+)$/', $argument, $m) === 1) {
            $out = $m[1];
        } elseif (preg_match('/^--port=(\d{2,5})$/', $argument, $m) === 1) {
            $port = (int) $m[1];
        } elseif (preg_match('/^--host=([\d.:a-fA-F]+)$/', $argument, $m) === 1) {
            $host = $m[1];
        } elseif (preg_match('#^--public=(https?://[^\s?]+)/?$#', $argument, $m) === 1) {
            $public = $m[1];
            $expose = true;
        }
    }

    $root = $target !== '' ? realpath($target) : false;
    if ($root === false || !is_dir($root)) {
        fwrite(\STDERR, '✗ '.Lang::t('cli.missing_path')."\n");
        exit(1);
    }

    $out ??= $root.'/sablier.json';
    $declaration = Declaration::load(is_file($out) ? $out : null);
    $scan = sablier_scanner($declaration)->scan($root);
    $findings = (new Assessor($declaration, (int) date('Y')))->assess($scan['findings']);
    $areas = Interview::areas($findings, $declaration);

    if ($areas === []) {
        printf("\n  %s\n\n", Lang::t('declare.nothing'));
        exit(0);
    }

    $directory = sys_get_temp_dir().'/sablier-web-'.bin2hex(random_bytes(4));
    @mkdir($directory, 0o755, true);
    $sessionFile = $directory.'/session.json';
    Session::create($sessionFile, [
        'target' => $root,
        // The name the client uses for the thing being audited. "This
        // application" means nothing to somebody who runs four of them.
        'project' => $declaration->project !== '' ? $declaration->project : basename($root),
        'out' => $out,
        'log' => \dirname($out).'/session.json',
        'report' => $directory.'/report.html',
        'areas' => $areas,
        'index' => 0,
        'answers' => [],
        'record' => [],
        'context' => [],
    ]);

    // A token the moment the server leaves the loopback. It is not
    // authentication — anyone the link reaches can answer — but an interview
    // that writes a declaration and runs a scan has no business being open to
    // whoever guesses the port.
    // Reached from outside, one way or another. A bind address is a bad judge of
    // that: behind an SSH tunnel and a reverse proxy the server stays on the
    // loopback and the link is still public, so the operator can say so with
    // --expose, and --public says it by naming the address being handed over.
    $local = \in_array($host, ['127.0.0.1', '::1', 'localhost'], true) && !$expose;
    $token = $local ? '' : bin2hex(random_bytes(8));
    Session::open($sessionFile)?->set('token', $token);

    $url = ($public ?? 'http://'.$host.':'.$port).'/'.($token !== '' ? '?k='.$token : '');
    printf("\n  %s\n", Lang::t('web.serving', $url));
    if (!$local) {
        printf("  %s\n", Lang::t('web.serving.exposed'));
    }
    printf("  %s\n\n", Lang::t('web.serving.stop'));

    // Opening the browser is a convenience for a person, and a nuisance for
    // everything else. The test suite starts this server twice per run, and on
    // a developer's machine that was two windows every time the suite ran —
    // reported as a bug, and rightly. A pipe instead of a terminal says nobody
    // is watching, so nothing is opened.
    $watched = !\function_exists('posix_isatty') || @posix_isatty(\STDOUT);
    foreach ($local && $public === null && $watched ? ['open', 'xdg-open'] : [] as $opener) {
        if (trim((string) @shell_exec('command -v '.escapeshellarg($opener).' 2>/dev/null')) !== '') {
            @shell_exec(\sprintf('%s %s >/dev/null 2>&1 &', $opener, escapeshellarg($url)));
            break;
        }
    }

    // exec, so the server replaces the shell instead of hiding behind it: a
    // stray php -S holding the port after its parent was killed is a bad way
    // to learn that the command leaked a process.
    $command = \sprintf(
        'exec env SABLIER_SESSION=%s SABLIER_LANG=%s %s -S %s:%d %s 2>/dev/null',
        escapeshellarg($sessionFile),
        escapeshellarg(Lang::locale()),
        escapeshellarg(\PHP_BINARY),
        $host,
        $port,
        escapeshellarg(__DIR__.'/../src/Web/router.php'),
    );
    passthru($command);
    exit(0);
}

// --- the interview: bin/sablier declare <path> --------------------------
// The only command in this tool meant to be run with somebody else in the
// room, and the only one whose output is a question rather than a verdict. It
// asks about retention and about harm — two things a person answers every
// week — and derives the lifetime nobody can state directly.
// --- the interview as one file: bin/sablier worksheet <path> ------------
// For a room with no network, a client who will not run a command, or a machine
// nobody may connect to. The questions and the subjects are baked in; the
// answers come back as a file, and the report is built here afterwards.
if ($command === 'worksheet') {
    $target = $argv[2] ?? '';
    $out = null;
    foreach (\array_slice($argv, 3) as $argument) {
        if (preg_match('/^--out=(.+)$/', $argument, $m) === 1) {
            $out = $m[1];
        }
    }

    $root = $target !== '' ? realpath($target) : false;
    if ($root === false || !is_dir($root)) {
        fwrite(\STDERR, '✗ '.Lang::t('cli.missing_path')."\n");
        exit(1);
    }

    $declaration = Declaration::load(is_file($root.'/sablier.json') ? $root.'/sablier.json' : null);
    $scan = sablier_scanner($declaration)->scan($root);
    $findings = (new Assessor($declaration, (int) date('Y')))->assess($scan['findings']);
    $areas = Interview::areas($findings, $declaration);
    if ($areas === []) {
        printf("\n  %s\n\n", Lang::t('declare.nothing'));
        exit(0);
    }

    $out ??= 'worksheet.html';
    $project = $declaration->project !== '' ? $declaration->project : basename($root);
    file_put_contents($out, Worksheet::render($project, $areas, date('Y-m-d')));
    printf("\n  %s\n\n", Lang::t('worksheet.written', $out));
    exit(0);
}

if ($command === 'declare') {
    $target = $argv[2] ?? '';
    $out = null;
    $log = null;
    $import = null;
    foreach (\array_slice($argv, 3) as $argument) {
        if (preg_match('/^--out=(.+)$/', $argument, $m) === 1) {
            $out = $m[1];
        } elseif (preg_match('/^--log=(.+)$/', $argument, $m) === 1) {
            $log = $m[1];
        } elseif (preg_match('/^--import=(.+)$/', $argument, $m) === 1) {
            $import = $m[1];
        }
    }

    $root = $target !== '' ? realpath($target) : false;
    if ($root === false || !is_dir($root)) {
        fwrite(\STDERR, '✗ '.Lang::t('cli.missing_path')."\n");
        exit(1);
    }

    $out ??= $root.'/sablier.json';
    $declaration = Declaration::load(is_file($out) ? $out : null);
    $scan = sablier_scanner($declaration)->scan($root);

    $findings = (new Assessor($declaration, (int) date('Y')))->assess($scan['findings']);
    $areas = Interview::areas($findings, $declaration);

    // Answers filled in elsewhere — the single-file worksheet, on a machine
    // with no network. They go through the same merge as the ones typed here,
    // because a second answer carrying a name already used means the same thing
    // wherever it was given.
    if ($import !== null) {
        $payload = Value::map(json_decode((string) @file_get_contents($import), true));
        $answers = [];
        foreach (Value::map($payload['answers'] ?? null) as $entry) {
            $answer = Value::map($entry);
            $name = trim(Value::string($answer['name'] ?? null));
            if ($name === '') {
                continue;
            }
            $answers[] = [
                'name' => $name,
                'paths' => Value::strings($answer['paths'] ?? null),
                'lifetime' => Value::int($answer['lifetime'] ?? null),
                'note' => Value::string($answer['note'] ?? null),
                'trust_anchor' => ($answer['trust_anchor'] ?? false) === true,
                'declared_by' => Value::string($answer['declared_by'] ?? null),
            ];
        }

        if ($answers === []) {
            fwrite(\STDERR, '✗ '.Lang::t('worksheet.import.unreadable', $import)."\n");
            exit(1);
        }

        /** @var array<string, mixed> $existing */
        $existing = is_file($out) ? Value::map(json_decode((string) file_get_contents($out), true)) : [];
        /** @var array<string, mixed> $context */
        $context = Value::map($payload['context'] ?? null);
        unset($context['who']);
        /** @var array<string, mixed> $base */
        $base = [...$existing, ...$context];
        $merged = Interview::merge($base, $answers);
        file_put_contents($out, json_encode($merged, \JSON_PRETTY_PRINT | \JSON_UNESCAPED_SLASHES | \JSON_UNESCAPED_UNICODE)."\n");

        $log ??= \dirname($out).'/session.json';
        file_put_contents($log, json_encode([
            'project' => basename($root),
            'finished_at' => (new \DateTimeImmutable())->format(\DateTimeInterface::ATOM),
            'answered' => \count($answers),
            'source' => basename($import),
            'record' => Value::map($payload['record'] ?? null),
            'feedback' => Value::map($payload['feedback'] ?? null),
        ], \JSON_PRETTY_PRINT | \JSON_UNESCAPED_SLASHES | \JSON_UNESCAPED_UNICODE)."\n");

        printf("\n  %s\n", Lang::t('worksheet.imported', \count($answers), basename($import)));
        printf("  → %s\n  → %s\n\n", $out, $log);
        exit(0);
    }

    printf("\n  %s\n\n", Lang::t('declare.intro'));
    if ($areas === []) {
        printf("  %s\n\n", Lang::t('declare.nothing'));
        exit(0);
    }
    printf("  %s\n", Lang::t('declare.found', \count($areas)));
    printf("  %s\n", Lang::t('declare.target', basename($root)));

    // The hint and the examples are shown on the first subject and never
    // again: a person reads them once, and repeating them twelve times turns
    // the screen into a form rather than a conversation.
    $first = true;
    $ask = static function (string $question, bool $optional = false, bool $hint = false): ?string {
        while (true) {
            printf("\n  %s\n", $question);
            if ($optional && $hint) {
                printf("  %s\n", Lang::t('declare.q.skip'));
            }
            $line = fgets(\STDIN);
            if ($line === false) {
                return null;
            }
            $line = trim($line);
            if ($line !== '' || $optional) {
                return $line === '' ? null : $line;
            }
        }
    };

    $years = static function (string $question, bool $hint = false) use ($ask): ?int {
        while (true) {
            $answer = $ask($question, true, $hint);
            if ($answer === null) {
                return null;
            }
            if (preg_match('/^\d{1,3}$/', $answer) === 1) {
                return (int) $answer;
            }
            printf("  %s\n", Lang::t('declare.invalid'));
        }
    };

    $startedAt = microtime(true);

    // A duration and a date are not the same question, and a validator that
    // confuses them rejects "2032" as too long to be a number of years.
    $calendarYear = static function (string $question) use ($ask): ?int {
        while (true) {
            $answer = $ask($question, true, true);
            if ($answer === null) {
                return null;
            }
            if (preg_match('/^(20|21)\d{2}$/', $answer) === 1) {
                return (int) $answer;
            }
            printf("  %s\n", Lang::t('declare.invalid.year'));
        }
    };

    // Two questions about the system rather than about its data, asked once.
    // They move every verdict below them: how long the thing will keep writing
    // secrets, and whose deadline it answers to.
    $project = [];
    $serviceUntil = $calendarYear(Lang::t('declare.q.service'));
    if ($serviceUntil !== null) {
        $project['service_until'] = $serviceUntil;
        printf("  %s\n", Lang::t('declare.service.set', $serviceUntil));
    } else {
        printf("  %s\n", Lang::t('declare.service.unknown'));
    }

    $chosen = $ask(Lang::t('declare.q.regime'), true, true);
    $regime = match ($chosen) {
        '2' => 'anssi',
        '3' => 'nss',
        '1' => 'general',
        default => null,
    };
    if ($regime !== null) {
        $project['regime'] = $regime;
        printf("  %s\n", Lang::t('declare.regime.set',
            Declaration::REGIMES[$regime]['expiry'],
            Declaration::REGIMES[$regime]['source'],
        ));
    }

    $answers = [];
    $record = [];
    $skipped = 0;
    foreach ($areas as $index => $area) {
        // Per area, because the total says how long it took and this says
        // where it got hard. Hesitation is the measurement the session is
        // actually after, and asking somebody to time themselves with a
        // stopwatch while they think is how you stop them thinking.
        $areaStartedAt = microtime(true);
        printf("\n  ———\n  %s\n\n", Lang::t('declare.area', $index + 1, \count($areas), $area['files']));
        printf("  %s\n", wordwrap(Lang::t(Interview::subject($area['algorithms'])), 76, "\n  "));
        // Several places under one description: name the places. One place:
        // name the files in it.
        printf("  %s\n", Lang::t('declare.area.where', match (true) {
            \count($area['paths']) > 1 => implode(', ', $area['paths']),
            $area['files'] === 1 => $area['names'][0],
            default => implode(', ', array_map(basename(...), $area['names'])).($area['files'] > \count($area['names']) ? ' …' : ''),
        }));

        $name = $ask(Lang::t($first ? 'declare.q.name.first' : 'declare.q.name'), true, $first);
        if ($name === null) {
            ++$skipped;
            $record[] = ['area' => Interview::where($area['paths']), 'places' => $area['paths'], 'skipped' => true, 'seconds' => round(microtime(true) - $areaStartedAt, 1)];
            printf("  %s\n", Lang::t('declare.skipped'));
            continue;
        }

        $retention = $years(Lang::t('declare.q.retention'), $first);
        $damage = $years(Lang::t('declare.q.damage'), $first);
        if ($retention === null && $damage === null) {
            ++$skipped;
            $record[] = ['area' => Interview::where($area['paths']), 'places' => $area['paths'], 'name' => $name, 'skipped' => true, 'seconds' => round(microtime(true) - $areaStartedAt, 1)];
            printf("  %s\n", Lang::t('declare.skipped'));
            continue;
        }

        $lifetime = Interview::lifetime($retention ?? 0, $damage ?? 0);
        $why = match (true) {
            $lifetime === 0 => Lang::t('declare.derived.why.zero'),
            $lifetime === ($damage ?? 0) && $lifetime > ($retention ?? 0) => Lang::t('declare.derived.why.damage'),
            default => Lang::t('declare.derived.why.retention'),
        };
        printf("\n  %s\n", Lang::t('declare.derived', $lifetime, $why));

        $answers[] = [
            'name' => $name,
            'paths' => $area['patterns'],
            'lifetime' => $lifetime,
            'note' => $ask(Lang::t('declare.q.note'), true, $first) ?? '',
        ];

        $first = false;
        $seconds = round(microtime(true) - $areaStartedAt, 1);
        $record[] = [
            'area' => Interview::where($area['paths']),
            'places' => $area['paths'],
            'name' => $name,
            'retention_years' => $retention,
            'harm_years' => $damage,
            'lifetime_years' => $lifetime,
            'skipped' => false,
            'seconds' => $seconds,
        ];
    }

    if ($answers !== [] || $project !== []) {
        /** @var array<string, mixed> $existing */
        $existing = is_file($out) ? Value::map(json_decode((string) file_get_contents($out), true)) : [];
        $merged = Interview::merge([...$existing, ...$project], $answers);
        file_put_contents($out, json_encode($merged, \JSON_PRETTY_PRINT | \JSON_UNESCAPED_SLASHES | \JSON_UNESCAPED_UNICODE)."\n");
        printf("\n  %s\n", Lang::t('declare.written', \count($answers), basename($out)));
    }

    $elapsed = microtime(true) - $startedAt;

    // The sheet in docs/declaration-session.md asks for two of these by hand.
    // Filling them here is not a convenience: a number transcribed after the
    // fact is a number somebody rounded towards the result they hoped for.
    printf("\n  %s\n", Lang::t('declare.times'));
    foreach ($record as $entry) {
        printf(
            "    %s %s%s\n",
            mb_str_pad(\sprintf('%5.1f s', $entry['seconds']), 10),
            mb_str_pad((string) $entry['area'], 34),
            $entry['skipped'] ? ' — '.Lang::t('declare.times.skipped') : '',
        );
    }

    printf("\n  %s\n", Lang::t('declare.elapsed',
        $elapsed < 60 ? \sprintf('%d s', (int) $elapsed) : \sprintf('%d min %02d s', (int) ($elapsed / 60), (int) $elapsed % 60),
        \count($answers),
        $skipped,
    ));

    if ($log !== null) {
        file_put_contents($log, json_encode([
            'project' => basename($root),
            'started_at' => (new \DateTimeImmutable())->format(\DateTimeInterface::ATOM),
            'seconds' => round($elapsed, 1),
            'answered' => \count($answers),
            'skipped' => $skipped,
            'areas' => $record,
        ], \JSON_PRETTY_PRINT | \JSON_UNESCAPED_SLASHES | \JSON_UNESCAPED_UNICODE)."\n");
        printf("  → %s\n", $log);
    }

    echo "\n";
    exit(0);
}

// --- collect published vulnerabilities: bin/sablier advisories <path> ---
// The one command in this tool that is allowed to reach the network, and it
// reaches it for a database rather than with your inventory: the scanner runs
// in a container, reads the lock files from a read-only mount, and writes a
// file you can read. A scan never does any of that.
if ($command === 'advisories') {
    // Reaches a vulnerability database, in a container. Both are the network.
    if (Airgap::on()) {
        Airgap::refuse('advisories');
    }

    $target = $argv[2] ?? '';
    $out = '.sablier/advisories.json';
    foreach (\array_slice($argv, 3) as $argument) {
        if (preg_match('/^--out=(.+)$/', $argument, $m) === 1) {
            $out = $m[1];
        }
    }

    $root = $target !== '' ? realpath($target) : false;
    if ($root === false || !is_dir($root)) {
        fwrite(\STDERR, '✗ '.Lang::t('cli.missing_path')."\n");
        exit(1);
    }

    $docker = Docker::binary();
    if ($docker === null) {
        fwrite(\STDERR, '✗ '.Lang::t('advisories.no_docker')."\n");
        exit(1);
    }

    $scanner = getenv('SABLIER_TRIVY_IMAGE') ?: 'aquasec/trivy:0.75.0';
    $cache = (getenv('HOME') ?: sys_get_temp_dir()).'/.cache/trivy';
    @mkdir($cache, 0o755, true);
    printf("\n  %s\n", Lang::t('advisories.running', $scanner));

    $raw = (string) @shell_exec(\sprintf(
        '%s run --rm --volume %s:/root/.cache --volume %s:/project:ro %s fs --scanners vuln --format json --quiet /project 2>/dev/null',
        escapeshellarg($docker),
        escapeshellarg($cache),
        escapeshellarg($root),
        escapeshellarg($scanner),
    ));

    $report = Value::map(json_decode($raw, true));
    if ($report === []) {
        fwrite(\STDERR, '✗ '.Lang::t('advisories.failed', $scanner)."\n");
        exit(1);
    }

    $collected = Advisories::fromScannerReport($report, $scanner, $root);
    // dirname() always answers something, "." included; only a directory that
    // is not there yet needs creating.
    $directory = \dirname($out);
    if (!is_dir($directory)) {
        @mkdir($directory, 0o755, true);
    }
    file_put_contents($out, json_encode($collected, \JSON_PRETTY_PRINT | \JSON_UNESCAPED_SLASHES | \JSON_UNESCAPED_UNICODE)."\n");

    $packages = Value::map($collected['packages'] ?? null);
    printf("  %s\n", Lang::t('advisories.written', $out, \count($packages), Value::int($collected['other_vulnerable_packages'] ?? null)));
    printf("  %s\n\n", Lang::t('advisories.next', $out));
    exit(0);
}

// --- probe only: bin/sablier probe example.org --------------------------
if ($command === 'probe') {
    if (Airgap::on()) {
        Airgap::refuse('probe');
    }

    $target = $argv[2] ?? null;
    if ($target === null) {
        fwrite(\STDERR, '✗ '.Lang::t('cli.missing_host')."\n");
        exit(1);
    }
    $result = (new Probe())->run($target);
    printf("\n  %s\n\n", $target);
    foreach ($result['facts'] as $key => $value) {
        // mb_str_pad: printf counts bytes, so accents would shift the column.
        printf("    %s %s\n", mb_str_pad((string) $key, 28), $value);
    }
    foreach ($result['notes'] as $note) {
        printf("\n    ⚠ %s\n", wordwrap($note, 88, "\n      "));
    }
    foreach ($result['findings'] as $finding) {
        printf("\n    · %s — %s\n", Catalogue::label($finding->algorithm), $finding->detail);
    }
    echo "\n";
    exit(0);
}

// Past this point, two commands share one body: `scan` builds the inventory by
// reading a project, `judge` reads one somebody else's tool produced. Everything
// after the inventory — the risk model, the report, the baseline, the exit code
// — is the same, and that is the whole argument for the import.
if (!\in_array($command, ['scan', 'judge'], true)) {
    fwrite(\STDOUT, Lang::t('cli.usage')."\n");
    exit($command === 'help' ? 0 : 1);
}

$target = null;
$options = ['declare' => null, 'out' => null, 'json' => null, 'cbom' => null, 'audit' => null, 'calendar' => null, 'pdf' => null, 'year' => null, 'sign' => null, 'baseline' => null, 'advisories' => null, 'quiet' => false, 'no-probe' => false];
foreach (\array_slice($argv, 2) as $arg) {
    if ($arg === '--quiet' || $arg === '--no-probe') {
        $options[substr($arg, 2)] = true;
    } elseif (preg_match('/^--(declare|out|json|cbom|audit|calendar|pdf|year|sign|baseline|advisories)=(.+)$/', $arg, $m) === 1) {
        $options[$m[1]] = $m[2];
    } elseif (!str_starts_with($arg, '--')) {
        $target = $arg;
    }
}

// Where the HTML goes, and whether it goes anywhere at all. Run by hand without
// --out, you want a report, so there is a default. Run with --quiet, you want
// the verdict in the exit code — that is the pipeline's usage, and dropping an
// unrequested page into somebody's repository is leaving state behind. It is
// still written when something downstream needs it: the PDF is rendered from
// it, and the signature is filed beside it.
$reportPath = $options['out'];
if ($reportPath === null && (!$options['quiet'] || $options['pdf'] !== null || $options['sign'] !== null)) {
    $reportPath = 'report.html';
}

if ($target === null || ($command === 'scan' ? !is_dir($target) : !is_file($target))) {
    fwrite(\STDERR, '✗ '.Lang::t($command === 'scan' ? 'cli.missing_path' : 'cli.missing_cbom')."\n");
    exit(1);
}

// A scanned project carries its declaration; an imported CBOM has none of its
// own, so the declaration is the one in the hand that runs the command.
$declarationPath = $options['declare'] ?? match (true) {
    $command === 'scan' && is_file($target.'/sablier.json') => $target.'/sablier.json',
    $command === 'judge' && is_file('sablier.json') => 'sablier.json',
    default => null,
};
$declaration = Declaration::load($declarationPath);
// --year projects the same codebase into a future year. The expiry date does
// not move — it is a regulatory deadline — but the other side of the comparison
// does: every year that passes pushes more data over the line. Worth being able
// to show, and worth marking loudly so a projection is never read as a finding.
$actualYear = (int) date('Y');
$currentYear = $options['year'] !== null ? (int) $options['year'] : $actualYear;

$startedAt = microtime(true);

$probes = [];
$importedFrom = '';
if ($command === 'scan') {
    // Composition happens here and nowhere else: the scanner receives what it
    // must run, instead of knowing the list itself.
    $scan = sablier_scanner($declaration)->scan($target);

    // Live probes come from the declaration: what a server negotiates belongs
    // to the same inventory as what the code says, and it is the only part a
    // file can contradict.
    $probeFindings = [];
    // Declared hosts on a closed site: skipped rather than refused, because an
    // audit stopped by its own flag helps nobody — and said out loud in the
    // blind spots, which is what that section is for.
    $airgapSkippedProbe = Airgap::on() && $declaration->probe !== [];
    if (!$options['no-probe'] && !Airgap::on()) {
        foreach ($declaration->probe as $host) {
            $result = (new Probe())->run($host);
            $probes[] = ['target' => $host, 'facts' => $result['facts'], 'notes' => $result['notes']];
            $probeFindings = [...$probeFindings, ...$result['findings']];
        }
    }

    $inventory = [...$scan['findings'], ...$probeFindings];
    $filesRead = $scan['files'];
    $blind = $scan['blind'];
    if (Airgap::on()) {
        $blind[] = $airgapSkippedProbe
            ? Lang::t('airgap.blind.skipped', \count($declaration->probe))
            : Lang::t('airgap.blind.on');
    }
    $label = $target;
} else {
    // Somebody else's inventory. We judge it; we did not detect it, and the
    // report says so rather than borrowing the credit — along with what the
    // import could not understand, which is the part a silent importer hides.
    $imported = Cbom::read($target);
    if ($imported === null) {
        fwrite(\STDERR, '✗ '.Lang::t('cbom.unreadable', $target)."\n");
        exit(1);
    }

    $inventory = $imported['findings'];
    $filesRead = $imported['locations'];
    $label = $imported['project'];
    $importedFrom = $imported['producer'];
    $blind = [Lang::t('cbom.blind.imported', \count($inventory), $imported['producer'])];
    if ($imported['ignored'] !== []) {
        $names = array_slice(array_values(array_unique($imported['ignored'])), 0, 8);
        $blind[] = Lang::t('cbom.blind.ignored', \count($imported['ignored']), implode(', ', $names));
    }
    if ($imported['unplaced'] > 0) {
        $blind[] = Lang::t('cbom.blind.no_location', $imported['unplaced']);
    }
}

// Published vulnerabilities are read from a file the operator collected on
// purpose. Absent, the report says the question was not asked rather than
// implying the answer was no.
$advisories = null;
if ($options['advisories'] !== null) {
    $advisories = Advisories::load($options['advisories']);
    if ($advisories === null) {
        fwrite(\STDERR, '✗ '.Lang::t('advisories.unreadable', $options['advisories'])."\n");
        exit(1);
    }
    $blind[] = Lang::t('advisories.blind.used', $advisories->scanner, substr($advisories->generatedAt, 0, 10), $advisories->count(), $advisories->ignored);
} else {
    $blind[] = Lang::t('advisories.blind.absent');
}

$findings = (new Assessor($declaration, $currentYear, $advisories))->assess($inventory);
$duration = microtime(true) - $startedAt;

// Signing happens after the analysis and over the findings, never over the
// rendered file: two runs of the same inventory differ byte for byte and say
// exactly the same thing.
$signature = null;
if ($options['sign'] !== null) {
    $preliminary = new Analysis($findings, $declaration, $label, $filesRead, $blind, $currentYear);

    // Two ways to hold a signing key, and the second is the one an auditor
    // should want: a pair made for this report, used once, and gone before the
    // command returns. Nothing to store, nothing to steal, nothing to rotate,
    // and a key that can never sign a second document. What proves who signed
    // is then the channel that carries the fingerprint, not a file on a laptop.
    $ephemeral = $options['sign'] === 'ephemeral';
    $fingerprint = '';
    if ($ephemeral) {
        $pair = Signature::keypair();
        $pq = MlDsa::keypair();
        $secret = $pair['secret'];
        $pqSecret = $pq['secret'] ?? '';
        $fingerprint = Signature::fingerprint($pair['public'], $pq['public'] ?? '');
    } else {
        if (!is_file($options['sign'])) {
            fwrite(\STDERR, '✗ '.Lang::t('cli.key_missing', $options['sign'])."\n");
            exit(1);
        }
        $hybridKey = Signature::hybridKeyPath($options['sign']);
        $secret = trim((string) file_get_contents($options['sign']));
        $pqSecret = is_file($hybridKey) ? (string) file_get_contents($hybridKey) : '';
    }

    $signature = Signature::sign(
        Signature::digest($preliminary),
        $secret,
        // Whatever was signed at this path before. No flag: a second run over
        // the same output succeeds the first, and a chain nobody has to ask
        // for is a chain that exists.
        Signature::previousDigest($reportPath.'.sig'),
        $pqSecret,
    );

    // The private halves leave with the command that made them.
    if ($ephemeral) {
        $signature['ephemeral'] = true;
        sodium_memzero($secret);
        if ($pqSecret !== '') {
            sodium_memzero($pqSecret);
        }
    }
    file_put_contents($reportPath.'.sig', json_encode($signature, \JSON_PRETTY_PRINT | \JSON_UNESCAPED_SLASHES)."\n");
}

$analysis = new Analysis(
    findings: $findings,
    declaration: $declaration,
    target: $label,
    filesRead: $filesRead,
    blindSpots: $blind,
    currentYear: $currentYear,
    duration: $duration,
    probes: $probes,
    projected: $currentYear !== $actualYear,
    signature: $signature,
    importedFrom: $importedFrom,
    // Printed in the audit report: a document that cannot be reproduced is an
    // assertion, not a finding.
    commandLine: implode(' ', array_map(
        static fn (string $argument): string => str_contains($argument, ' ') ? '"'.$argument.'"' : $argument,
        $argv,
    )),
);

if ($reportPath !== null) {
    file_put_contents($reportPath, (new HtmlReporter())->render($analysis));
}

if ($options['json'] !== null) {
    file_put_contents($options['json'], (new JsonReporter())->render($analysis));
}

// The inventory in the format other tools read. The house JSON stays for our
// own baseline; this one is for everybody else's pipeline.
if ($options['cbom'] !== null) {
    file_put_contents($options['cbom'], (new CbomReporter())->render($analysis)."\n");
}

// The same analysis, written for whoever has to weigh it rather than act on
// it. A second document rather than a mode of the first: they are read by
// different people, in different rooms.
if ($options['audit'] !== null) {
    file_put_contents($options['audit'], (new AuditReporter())->render($analysis));
}

// The crossings as appointments. A date in a report is read once; a date in a
// calendar interrupts somebody in 2029, which is the only version that works.
if ($options['calendar'] !== null) {
    file_put_contents($options['calendar'], Crossings::toIcalendar($analysis));
}

$pdfMessage = null;
$auditPdfMessage = null;
if ($options['pdf'] !== null && $reportPath !== null) {
    [, $pdfMessage] = Pdf::render($reportPath, $options['pdf']);
    // The audit document is the one that gets printed, signed and filed, so
    // asking for a PDF asks for both. Its name is the audit file's, which is
    // predictable enough not to need an option of its own.
    if ($options['audit'] !== null) {
        $auditPdf = preg_replace('/\.html?$/i', '', $options['audit']).'.pdf';
        [, $auditPdfMessage] = Pdf::render($options['audit'], $auditPdf);
    }
}

$counts = [];
foreach ($findings as $finding) {
    $counts[$finding->verdict] = ($counts[$finding->verdict] ?? 0) + 1;
}

// --- what changed since the reference run --------------------------------
// The exit code is decided here, before anything is printed, because --quiet
// exists for pipelines: a step that stays silent must still be able to stop
// the build.
$diff = null;
if ($options['baseline'] !== null) {
    $baseline = Baseline::load($options['baseline']);
    if ($baseline === null) {
        fwrite(\STDERR, '✗ '.Lang::t('diff.missing', $options['baseline'], $options['baseline'])."\n");
        exit(1);
    }
    $diff = $baseline->compare($findings);
}

$status = $diff !== null
    ? ($diff['decisions'] > 0 ? 2 : 0)
    : (($counts[Assessor::COMPROMISED] ?? 0) > 0 ? 2 : 0);

// Columns are padded to the widest entry of this run rather than to a fixed
// guess: verdict labels differ by language, and a ragged list of findings is
// read as a dump instead of a table.
$verdictText = static fn (Finding $finding, string $from): string => ($from === '' ? '' : Assessor::label($from).' → ').Assessor::label($finding->verdict);
$width = ['verdict' => 0, 'algorithm' => 0];
if ($diff !== null) {
    $entries = [...array_map(static fn (Finding $f): array => [$f, ''], $diff['new']),
        ...array_map(static fn (array $c): array => [$c['finding'], $c['from']], $diff['worsened']),
        ...array_map(static fn (Finding $f): array => [$f, ''], $diff['red'])];
    foreach ($entries as [$finding, $from]) {
        $width['verdict'] = max($width['verdict'], mb_strlen($verdictText($finding, $from)));
        $width['algorithm'] = max($width['algorithm'], mb_strlen($finding->algorithm));
    }
}

/** One line per finding: its fingerprint first, because that is what you type next. */
$line = static function (Finding $finding, string $from = '') use ($verdictText, $width): string {
    return \sprintf(
        "        %s  %s  %s  %s\n",
        $finding->fingerprint(),
        mb_str_pad($verdictText($finding, $from), $width['verdict']),
        mb_str_pad($finding->algorithm, $width['algorithm']),
        $finding->file.($finding->line > 0 ? ':'.$finding->line : ''),
    );
};

$verdictLine = static function (?array $diff): void {
    if ($diff === null) {
        return;
    }
    echo $diff['decisions'] > 0
        ? \sprintf("  ✗ %s\n     %s\n\n", Lang::t('diff.stop', Value::int($diff['decisions'])), Lang::t('diff.how'))
        : \sprintf("  ✓ %s\n\n", Lang::t('diff.go'));
};

if ($options['quiet']) {
    if ($pdfMessage !== null) {
        printf("  %s\n", $pdfMessage);
    }
    $verdictLine($diff);
    exit($status);
}

$sourceLabel = $importedFrom !== ''
    ? Lang::t('report.imported_from', $importedFrom, $filesRead)
    : Lang::t('report.files_read', $filesRead);
printf("\n  %s — %s, %s, %.1f s\n", $label, $sourceLabel, Lang::t('cli.findings', \count($findings)), $duration);
// The colon belongs to the label: French puts a space before it, English does not.
printf("  %s %s\n\n", Lang::t('cli.declaration'), $declarationPath ?? Lang::t('cli.no_declaration'));
foreach (Assessor::order() as $verdict) {
    if (isset($counts[$verdict])) {
        printf("    %s %d\n", mb_str_pad(Assessor::label($verdict), 24), $counts[$verdict]);
    }
}
echo "\n";
if ($reportPath !== null) {
    printf("  → %s\n", $reportPath);
}
if ($options['cbom'] !== null) {
    printf("  → %s\n", $options['cbom']);
}
if ($options['audit'] !== null) {
    printf("  → %s\n", $options['audit']);
}
if ($options['calendar'] !== null) {
    printf("  → %s\n", $options['calendar']);
}
if ($auditPdfMessage !== null) {
    printf("  → %s\n", $auditPdfMessage);
}
if ($pdfMessage !== null) {
    printf("  → %s\n", $pdfMessage);
}
if ($signature !== null) {
    printf("  → %s\n", Lang::t('cli.signed', $reportPath.'.sig'));
    if ($fingerprint !== '') {
        printf("\n  %s\n\n    %s\n\n  %s\n", Lang::t('seal.ephemeral.done'), $fingerprint, Lang::t('seal.ephemeral.send'));
    }
}
echo "\n";

if ($diff !== null) {
    // The reference names itself: reading the path back out of the options bag
    // asks every reader, human or machine, to prove it is still a string.
    printf("  %s\n", Lang::t('diff.header', $baseline->path, $baseline->count()));
    if ($diff['new'] !== [] || $diff['worsened'] !== [] || $diff['red'] !== [] || $diff['resolved'] !== []) {
        echo "\n";
    }
    if ($diff['new'] !== []) {
        printf("    + %s\n", Lang::t('diff.new', \count($diff['new'])));
        foreach ($diff['new'] as $finding) {
            echo $line($finding);
        }
    }
    if ($diff['worsened'] !== []) {
        printf("    ↑ %s\n", Lang::t('diff.worse', \count($diff['worsened'])));
        foreach ($diff['worsened'] as $change) {
            echo $line($change['finding'], $change['from']);
        }
    }
    if ($diff['red'] !== []) {
        printf("    ● %s\n", Lang::t('diff.red', \count($diff['red'])));
        foreach ($diff['red'] as $finding) {
            echo $line($finding);
        }
    }
    if ($diff['resolved'] !== []) {
        printf("    − %s\n", Lang::t('diff.gone', \count($diff['resolved'])));
    }
    echo "\n";
}

$verdictLine($diff);

// Non-zero exit when a decision is due: a new finding, a verdict that got
// worse, a red finding nobody has decided on — or, with no reference to
// compare against, long-lived data already exposed. That is what makes this
// usable as a pipeline step.
exit($status);
