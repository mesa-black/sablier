#!/usr/bin/env php
<?php

/*
 * Sablier — cryptographic inventory, and the expiry date of each protection.
 *
 *   bin/sablier help      every command and option (the text is cli.usage in
 *                         translations/, one per language)
 *
 * No dependency, no network call of its own, no telemetry. On a tool that reads
 * where the keys are, that is not a posture: every dependency would be one more
 * supply chain to defend.
 */

declare(strict_types=1);

// A four-line autoloader rather than a require list that has to be kept in
// order: adding a detector must not mean editing this file.
spl_autoload_register(static function (string $class): void {
    if (str_starts_with($class, 'Sablier\\')) {
        $path = __DIR__.'/../src/'.str_replace('\\', '/', substr($class, 8)).'.php';
        if (is_file($path)) {
            require $path;
        }
    }
});

// This file is a script, not a library: it stays in the global namespace and
// imports what it uses. A namespace declaration cannot legally follow the
// shebang line anyway — PHP tolerates it, the specification does not, and an
// entry point that makes an editor shout is a poor advertisement for a tool
// that spends its time telling people what is wrong with their code.
use Sablier\Advisories;
use Sablier\Airgap;
use Sablier\Analysis;
use Sablier\Assessor;
use Sablier\Baseline;
use Sablier\Breach;
use Sablier\Catalogue;
use Sablier\Crossings;
use Sablier\Cbom;
use Sablier\Declaration;
use Sablier\Docker;
use Sablier\Detector\AssetDetector;
use Sablier\Detector\DependencyDetector;
use Sablier\Detector\EnvDetector;
use Sablier\Detector\FrameworkConfigDetector;
use Sablier\Detector\FrameworkYamlDetector;
use Sablier\Detector\LaravelDetector;
use Sablier\Detector\KeyMaterialDetector;
use Sablier\Detector\PhpDetector;
use Sablier\Detector\ServerConfigDetector;
use Sablier\Detector\ShellDetector;
use Sablier\Detector\SshConfigDetector;
use Sablier\Detector\SymfonyVaultDetector;
use Sablier\Detector\TerraformDetector;
use Sablier\Finding;
use Sablier\Interview;
use Sablier\Lang;
use Sablier\MlDsa;
use Sablier\OpenTimestamps;
use Sablier\Ots\BlockHeader;
use Sablier\Ots\Proof;
use Sablier\Pdf;
use Sablier\Probe;
use Sablier\Worksheet;
use Sablier\Reporter\AuditReporter;
use Sablier\Reporter\CbomReporter;
use Sablier\Reporter\IncidentReporter;
use Sablier\Reporter\HtmlReporter;
use Sablier\Reporter\JsonReporter;
use Sablier\Scanner;
use Sablier\Seal;
use Sablier\Signature;
use Sablier\Sky;
use Sablier\Timestamp;
use Sablier\Value;
use Sablier\Version;
use Sablier\Web\Session;

// Arguments are read through the same door as every other outside value: a
// list of strings, whatever the runtime put in $_SERVER.
/** @var list<string> $argv */
$argv = array_values(array_map(
    static fn (mixed $argument): string => Value::string($argument),
    Value::map($_SERVER['argv'] ?? null),
));
$command = $argv[1] ?? 'help';

// Language is read before anything else: the help text is translated too.
Lang::use(getenv('SABLIER_LANG') ?: 'fr');
foreach ($argv as $arg) {
    if (preg_match('/^--lang=(\w+)$/', $arg, $m) === 1) {
        Lang::use($m[1]);
    } elseif ($arg === '--airgap') {
        Airgap::enable();
    }
}

if ($command === '--version' || $command === 'version') {
    printf("%s\n", Version::label());
    exit(0);
}

/**
 * Every detector, in one place.
 *
 * Four commands walk a project — scan, declare, serve and worksheet — and a
 * detector added to three of them is a detector that silently does not exist in
 * the fourth.
 */
function sablier_scanner(Declaration $declaration): Scanner
{
    return new Scanner([
        new PhpDetector(),
        new ShellDetector(),
        new KeyMaterialDetector(),
        new AssetDetector(),
        new ServerConfigDetector(),
        new SshConfigDetector(),
        new EnvDetector(),
        new FrameworkConfigDetector(),
        new FrameworkYamlDetector(),
        new LaravelDetector(),
        new SymfonyVaultDetector(),
        new DependencyDetector(),
        new TerraformDetector(),
    ], $declaration->exclude);
}

/**
 * The heading of one probed server. A server found through `mx://` says which
 * domain sent the probe there: mx01.mail.icloud.com alone would read as a host
 * somebody declared on purpose.
 */
/**
 * The path from a page to a file beside it or below it, as an href.
 *
 * Empty when the file is anywhere else: a link that climbs out of the page's
 * directory breaks the moment the page is sent on its own, and a report that
 * travels is the case this link is for. Directories are resolved rather than
 * compared as text, so `./out/r.html` and `out/r.pdf` are recognised as
 * neighbours.
 */
function sablier_link_below(string $page, string $file): string
{
    $from = realpath(dirname($page));
    $to = realpath(dirname($file));
    if ($from === false || $to === false) {
        return '';
    }
    if ($to === $from) {
        $relative = '';
    } elseif (str_starts_with($to, rtrim($from, '/').'/')) {
        $relative = substr($to, \strlen(rtrim($from, '/')) + 1).'/';
    } else {
        return '';
    }

    return implode('/', array_map('rawurlencode', explode('/', $relative.basename($file))));
}

function sablier_probe_heading(string $declared, string $host): string
{
    return $declared === $host ? $host : $host.' · '.Lang::t('probe.mx.of', substr($declared, \strlen('mx://')));
}

/**
 * Complete and check one OpenTimestamps proof, printing what it establishes.
 *
 * Shared by `verify`, which finds the proof beside a signature, and `anchor`,
 * which is handed one: the same proof must read the same way whichever door a
 * reader came in by.
 *
 * Completing comes first and needs the network, so it is skipped under
 * --airgap rather than refused — a closed site can still check a proof that
 * was completed elsewhere, with the block header carried in by hand. The file
 * is rewritten only when it gained a Bitcoin attestation: `verify` is otherwise
 * a reading command, and the one write it does is the one that turns a promise
 * into evidence.
 *
 * @param list<string> $args the command's own arguments
 * @param array{anchors?:list<array{height:int, state:string, reason:string, detail:string, time:int, source:string}>, pending?:list<string>} $found
 *                     filled with what the check found, for `verify --json`
 *
 * @return bool whether the proof failed
 */
function sablier_anchor_check(string $path, Proof $proof, array $args, array &$found = []): bool
{
    $headers = [];
    $named = [];
    $failed = false;
    foreach ($args as $arg) {
        if (preg_match('/^--block-header=(.+)$/', $arg, $m) === 1) {
            // Repeatable, or comma-separated: a proof merged from several
            // calendars can sit in two blocks, and each needs its header.
            foreach (explode(',', $m[1]) as $hex) {
                $header = BlockHeader::fromHex($hex);
                if ($header === null) {
                    printf("  ✗ %s\n", Lang::t('anchor.header.bad_hex', substr(trim($hex), 0, 16)));
                    $failed = true;
                } else {
                    $headers[] = $header;
                }
            }
        } elseif (preg_match('/^--calendar-url=(.+)$/', $arg, $m) === 1) {
            foreach (explode(',', $m[1]) as $url) {
                $named[] = trim($url);
            }
        }
    }

    if (!Airgap::on()) {
        $upgrade = OpenTimestamps::upgrade($proof, $named);
        foreach ($upgrade['errors'] as $error) {
            printf("  · %s\n", Lang::t($error['error'], $error['detail']));
        }
        if ($upgrade['changed']) {
            if (OpenTimestamps::save($path, $proof)) {
                printf("  %s\n", Lang::t('verify.anchor.upgraded', $path));
            } else {
                // The completed proof would not read back: the file keeps the
                // older one, and what is checked below is what is on disk.
                printf("  ✗ %s\n", Lang::t('anchor.unsaved', $path));
                $reloaded = OpenTimestamps::load($path);
                if (!isset($reloaded['proof'])) {
                    return true;
                }
                $proof = $reloaded['proof'];
            }
        }
    }

    $check = OpenTimestamps::check($proof, $headers, !Airgap::on());
    $found = ['anchors' => $check['anchors'], 'pending' => $check['pending']];
    $valid = false;
    foreach ($check['anchors'] as $anchor) {
        $reason = $anchor['reason'] !== '' ? Lang::t($anchor['reason'], $anchor['detail']) : '';
        if ($anchor['state'] === 'valid') {
            $valid = true;
            printf("  %s\n", Lang::t('verify.anchor.valid', $anchor['height'], OpenTimestamps::readable($anchor['time']), $anchor['source']));
        } elseif ($anchor['state'] === 'invalid') {
            // One anchoring that does not hold condemns the proof, as one
            // invalid token condemns the set: it is the state that says the
            // file claims a block it is not in.
            $failed = true;
            printf("  ✗ %s\n", Lang::t('verify.anchor.invalid', $anchor['height'], $reason));
        } else {
            printf("  %s\n", Lang::t('verify.anchor.unchecked', $anchor['height'], $reason));
            if ($anchor['reason'] === 'anchor.offline') {
                printf("  %s\n", Lang::t('verify.anchor.offline', $anchor['height']));
            }
        }
    }
    if ($check['anchors'] === [] && $check['pending'] !== []) {
        printf("  %s\n", Lang::t('verify.anchor.pending', implode(', ', $check['pending'])));
    }
    // Nothing to check and nothing to wait for: only notaries this tool does
    // not know, or branches it cannot compute. That passed with exit 0 once,
    // which read as "anchored" to anybody looking at the exit code alone.
    if ($check['anchors'] === [] && $check['pending'] === []) {
        $failed = true;
        printf("  ✗ %s\n", Lang::t('verify.anchor.none'));
    }
    if ($check['unsupported'] > 0) {
        printf("  %s\n", Lang::t('verify.anchor.unsupported', $check['unsupported']));
    }
    if ($check['unused'] > 0) {
        $failed = true;
        printf("  ✗ %s\n", Lang::t('verify.anchor.unused', $check['unused']));
    }
    if ($valid) {
        printf("  %s\n", Lang::t('verify.anchor.limit'));
    }

    return $failed;
}

/**
 * Sign one page as the file it is, beside it, as `<page>.page.sig`.
 *
 * Kept, not re-signed, when the existing signature already covers these exact
 * bytes with this key: the same page signed twice says nothing new. That is
 * rare — a page carries the date it was rendered — and it is not the
 * keep-the-oldest rule of the findings signature, which protects a date: here
 * the page is what is signed, and a new page gets a new signature.
 *
 * @return string the path of the signature file
 */
function sablier_sign_page(string $page, string $digest, string $secret, string $pqSecret, bool $ephemeral): string
{
    $path = Signature::pagePath($page);
    $existing = is_file($path) ? Value::map(json_decode((string) file_get_contents($path), true)) : [];
    $raw = base64_decode($secret, true);
    $publicKey = \is_string($raw) && \strlen($raw) === \SODIUM_CRYPTO_SIGN_SECRETKEYBYTES
        ? base64_encode(sodium_crypto_sign_publickey_from_secretkey($raw))
        : '';
    if (!$ephemeral && $publicKey !== ''
        && Value::string($existing['public_key'] ?? null) === $publicKey
        && Value::string($existing['sha256'] ?? null) === Signature::pageHash($page)
        && Value::string($existing['digest'] ?? null) === $digest) {
        return $path;
    }

    $block = Signature::signPage($page, $digest, $secret, $pqSecret);
    if ($ephemeral) {
        $block['ephemeral'] = true;
    }
    file_put_contents($path, json_encode($block, \JSON_PRETTY_PRINT | \JSON_UNESCAPED_SLASHES)."\n");

    return $path;
}

/**
 * Check a page against the signature filed beside it, and say so.
 *
 * @param array<mixed> $block the page signature
 * @param array<mixed> $report the findings signature it sits beside, when there is one
 * @param bool $asked whether the page signature was named on the command line: a page that is
 *                    not there then fails, where beside a findings signature it is only noted
 *
 * @return bool whether the page holds
 */
function sablier_page_check(string $signaturePath, array $block, array $report, ?string $expectedKey, ?string $expectedPqKey, bool $asked = false): bool
{
    // The page is the file the signature is named after, beside it. The name
    // inside is signed, so a page renamed afterwards is reported as such rather
    // than as an alteration.
    $page = (string) preg_replace('/\.page\.sig$/', '', $signaturePath);
    $signedName = Value::string($block['file'] ?? null);
    if (!is_file($page) && $signedName !== '') {
        $page = dirname($signaturePath).'/'.$signedName;
    }

    // Beside a findings signature, the page is checked against the same keys
    // and the same analysis — a page signed by somebody else, or about other
    // findings, does not belong with this report however valid it is alone.
    $reportHybrid = Value::map($report['hybrid'] ?? null);
    if ($report !== []) {
        $expectedKey = ($expectedKey ?? '') !== '' ? $expectedKey : Value::string($report['public_key'] ?? null);
        $expectedPqKey = ($expectedPqKey ?? '') !== '' ? $expectedPqKey : Value::string($reportHybrid['public_key'] ?? null);
    }

    $result = Signature::verifyPage($block, $page, $expectedKey, $expectedPqKey);
    $name = basename($page);

    if ($result['valid'] && $report !== [] && Value::string($report['digest'] ?? null) !== Value::string($block['digest'] ?? null)) {
        $result = ['valid' => false, 'reason' => 'verify.page.other_findings', 'hybrid' => $result['hybrid']];
    }
    // A findings signature that carries a post-quantum half, beside a page
    // signature that does not: the page is then held by the one curve the
    // second half exists to outlive, and that is not the same guarantee.
    if ($result['valid'] && $reportHybrid !== [] && Value::map($block['hybrid'] ?? null) === []) {
        $result = ['valid' => false, 'reason' => 'verify.page.no_hybrid', 'hybrid' => 'absent'];
    }

    // Somebody holding the signatures without the page has nothing to compare,
    // and that is not an alteration — unless the page is what they asked about.
    if ($result['reason'] === 'verify.page.missing' && !$asked) {
        printf("  %s\n", Lang::t('verify.page.absent', $name));

        return true;
    }

    // The reasons shared with the findings signature — wrong key, altered
    // file — say which of the two signatures they are about.
    $mark = $result['valid'] ? '' : '✗ ';
    $about = str_starts_with($result['reason'], 'verify.page.') ? '' : Lang::t('verify.page.prefix', Signature::pagePath($name));
    // The sizes, as figures: what was signed and what is here now. A hash
    // tells a reader that something changed; a size lets them see it.
    $signedSize = \is_int($block['size'] ?? null) ? $block['size'] : null;
    $reason = $result['reason'] === 'verify.page.modified' && $signedSize === null ? 'verify.page.modified.unsized' : $result['reason'];
    printf("  %s%s%s\n", $mark, $about, Lang::t(
        $reason,
        $name,
        Signature::pagePath($name),
        Lang::number(max(0, Signature::pageSize($page))),
        Lang::number($signedSize ?? 0),
    ));
    if ($result['valid'] && $signedName !== '' && $signedName !== $name) {
        printf("  %s\n", Lang::t('verify.page.renamed', $signedName, $name));
    }
    if ($result['valid']) {
        $hybrid = Value::map($block['hybrid'] ?? null);
        printf("  %s\n", $hybrid !== []
            ? Lang::t(match ($result['hybrid']) {
                'valid' => 'verify.hybrid.valid',
                'invalid' => 'verify.hybrid.invalid',
                default => 'verify.hybrid.unavailable',
            }, Value::string($hybrid['algorithm'] ?? null))
            : Lang::t('verify.hybrid.none'));
    }

    return $result['valid'];
}

/**
 * Ask each authority to attest a digest, keeping any token that already does.
 *
 * Shared by `scan` and `seal`: one slot per authority, in the order they were
 * named, so an authority that was unreachable on one run does not push the
 * others down a slot and lose their antecedence. A failure is loud on stderr
 * and leaves its slot empty; it never fails the command.
 *
 * @param list<string> $authorities
 *
 * @return list<array{time:string, authority:string, algorithm:string, serial:string, imprint:string, path:string}>
 */
function sablier_attest_tokens(string $base, string $digest, array $authorities): array
{
    $timestamps = [];
    foreach ($authorities as $slot => $authority) {
        $tokenPath = Timestamp::path($base, $slot);

        // An existing token that attests this very digest is kept, and that is
        // the whole point rather than an optimisation: the claim worth making is
        // that these findings existed **as early as** some date, so overwriting
        // the first attestation with a later one throws away the evidence the
        // flag exists to produce.
        $held = is_file($tokenPath) ? (string) file_get_contents($tokenPath) : '';
        $previous = $held !== '' ? Timestamp::read($held) : null;
        if ($previous !== null && hash_equals($previous['imprint'], $digest)) {
            $timestamps[] = [...$previous, 'path' => $tokenPath];
            continue;
        }

        $attested = Timestamp::request($digest, $authority);
        if (isset($attested['token'])) {
            file_put_contents($tokenPath, $attested['token']);
            $read = Timestamp::read($attested['token']);
            if ($read !== null) {
                $timestamps[] = [...$read, 'path' => $tokenPath];
            }
        } else {
            // Loud, and the other authorities are still asked: corroboration
            // whose point is to survive one operator having a bad day would be
            // a strange thing to abandon the moment one operator has a bad day.
            fwrite(\STDERR, '✗ '.Lang::t($attested['error'], $attested['detail'])."\n");
        }
    }

    return $timestamps;
}

/**
 * Anchor a digest through the OpenTimestamps calendars, beside `$base`.
 *
 * Shared by `scan` and `seal`, with the rules of the tokens: loud but not
 * fatal when no calendar answers, and the oldest anchoring kept — an existing
 * proof of this digest is completed in place, never replaced by a newer one.
 *
 * @param list<string> $asked the calendars named on the command line
 *
 * @return array{state:string, height:int, time:int, calendars:list<string>, path:string, since:string}|null
 */
function sablier_attest_anchor(string $base, string $digest, array $asked): ?array
{
    $anchor = null;
    $anchorPath = OpenTimestamps::path($base);
    $calendars = OpenTimestamps::calendars($asked);
    $proof = null;
    $blocked = false;
    if (is_file($anchorPath)) {
        $held = OpenTimestamps::load($anchorPath);
        if (isset($held['error'])) {
            // Not overwritten: a file that does not read here may be a
            // proof in a format this version does not know, and replacing
            // it would destroy the one thing this flag exists to keep.
            fwrite(\STDERR, '✗ '.Lang::t('anchor.kept_unreadable', $anchorPath)."\n");
            $blocked = true;
        } elseif (hash_equals($held['proof']->hex(), $digest)) {
            $proof = $held['proof'];
            $upgrade = OpenTimestamps::upgrade($proof, $calendars);
            if ($upgrade['changed'] && !OpenTimestamps::save($anchorPath, $proof)) {
                fwrite(\STDERR, '✗ '.Lang::t('anchor.unsaved', $anchorPath)."\n");
                // Back to what is on disk, which stays the evidence; and if
                // even that no longer reads, nothing is stamped over it.
                $proof = OpenTimestamps::load($anchorPath)['proof'] ?? null;
                $blocked = $proof === null;
            }
        }
        // A proof of another digest belongs to findings that no longer
        // exist, exactly like a token with another imprint: it is replaced.
    }

    if ($proof === null && !$blocked) {
        $stamped = OpenTimestamps::stamp($digest, $calendars);
        foreach ($stamped['errors'] as $error) {
            fwrite(\STDERR, '✗ '.Lang::t($error['error'], $error['detail'])."\n");
        }
        if ($stamped['proof'] !== null) {
            $proof = $stamped['proof'];
            file_put_contents($anchorPath, $proof->serialise());
        } else {
            fwrite(\STDERR, '✗ '.Lang::t('anchor.none')."\n");
        }
    }

    if ($proof !== null) {
        $mtime = filemtime($anchorPath);
        $anchor = OpenTimestamps::summary(OpenTimestamps::check($proof)) + [
            'path' => $anchorPath,
            // When it was handed to the calendars, for the pending line. The
            // proof itself carries no date — that is the block's job — so
            // the file's own is the best witness of the submission there is.
            'since' => OpenTimestamps::readable($mtime === false ? time() : $mtime),
        ];
    }

    return $anchor;
}

/** A token's time as ISO 8601 in UTC, for a program; as given when it does not parse. */
function sablier_iso(string $time): string
{
    try {
        return (new \DateTimeImmutable($time))->setTimezone(new \DateTimeZone('UTC'))->format(\DateTimeInterface::ATOM);
    } catch (\Exception) {
        return $time;
    }
}

// --- keys and verification ---------------------------------------------
if ($command === 'keygen') {
    $out = 'sablier.key';
    foreach (\array_slice($argv, 2) as $arg) {
        if (preg_match('/^--out=(.+)$/', $arg, $m) === 1) {
            $out = $m[1];
        }
    }
    if (is_file($out)) {
        fwrite(\STDERR, '✗ '.Lang::t('cli.key_exists', $out)."\n");
        exit(1);
    }

    $pair = Signature::keypair();
    file_put_contents($out, $pair['secret']."\n");
    chmod($out, 0600);

    printf("  %s\n\n    \"signing_public_key\": \"%s\"\n\n  %s\n", Lang::t('cli.key_written', $out), $pair['public'], Lang::t('cli.key_next'));

    // The post-quantum half, beside the other one, when this machine can make
    // it. Written here rather than asked for: a second flag to remember is a
    // second flag nobody passes.
    $hybrid = MlDsa::keypair();
    if ($hybrid !== null) {
        $hybridPath = Signature::hybridKeyPath($out);
        file_put_contents($hybridPath, $hybrid['secret']);
        chmod($hybridPath, 0600);
        printf("\n  %s\n\n    \"signing_public_key_pq\": %s\n", Lang::t('cli.key_hybrid', MlDsa::ALGORITHM, $hybridPath), json_encode($hybrid['public'], \JSON_UNESCAPED_SLASHES));
    } else {
        printf("\n  %s\n", Lang::t('cli.key_hybrid.absent', MlDsa::ALGORITHM));
    }
    exit(0);
}

/**
 * The one artefact in this chain nobody was signing.
 *
 * Every verdict in every report rests on durations a human declared, and until
 * now `declared_by` was a string anybody could type. This signs the decisions —
 * not the bytes — so the person who committed to a ten-year confidentiality can
 * be the person who answers for it, and the audit document says whether the file
 * it depends on is still the one that was endorsed.
 *
 * Ephemeral by default, for the same reason the reports are: a key that signs
 * once and is destroyed proves what the channel carrying its fingerprint proves,
 * and leaves nothing on a laptop to steal. A declaration endorsed at the end of
 * an interview is exactly the case that key was invented for.
 */
if ($command === 'endorse') {
    $target = $argv[2] ?? '';
    $key = 'ephemeral';
    foreach (\array_slice($argv, 3) as $arg) {
        if (preg_match('/^--sign=(.+)$/', $arg, $m) === 1) {
            $key = $m[1];
        }
    }
    if (!is_file($target)) {
        fwrite(\STDERR, '✗ '.Lang::t('cli.endorse_usage')."\n");
        exit(1);
    }

    $endorsed = Declaration::load($target);
    if ($endorsed->domains === []) {
        fwrite(\STDERR, '✗ '.Lang::t('cli.endorse_empty', $target)."\n");
        exit(1);
    }

    $ephemeral = $key === 'ephemeral';
    if ($ephemeral) {
        $pair = Signature::keypair();
        $pq = MlDsa::keypair();
        $secret = $pair['secret'];
        $pqSecret = $pq['secret'] ?? '';
        $fingerprint = Signature::fingerprint($pair['public'], $pq['public'] ?? '');
    } else {
        if (!is_file($key)) {
            fwrite(\STDERR, '✗ '.Lang::t('cli.key_missing', $key)."\n");
            exit(1);
        }
        $hybridKey = Signature::hybridKeyPath($key);
        $secret = trim((string) file_get_contents($key));
        $pqSecret = is_file($hybridKey) ? (string) file_get_contents($hybridKey) : '';
        $fingerprint = '';
    }

    $block = Signature::sign($endorsed->digest(), $secret, '', $pqSecret);
    if ($ephemeral) {
        $block['ephemeral'] = true;
        sodium_memzero($secret);
        if ($pqSecret !== '') {
            sodium_memzero($pqSecret);
        }
    }
    // What the signature covers, so a reader of the file alone knows which
    // digest to recompute and from what.
    file_put_contents(
        $target.'.sig',
        json_encode(['covers' => 'declaration'] + $block, \JSON_PRETTY_PRINT | \JSON_UNESCAPED_SLASHES)."\n",
    );

    printf("  %s\n", Lang::t('cli.endorse_written', $target.'.sig', \count($endorsed->domains)));
    if ($fingerprint !== '') {
        printf("\n  %s\n\n    %s\n\n  %s\n", Lang::t('seal.ephemeral.done'), $fingerprint, Lang::t('cli.endorse_send'));
    }
    printf("\n  %s\n", Lang::t('cli.endorse_verify', $target, $target));
    exit(0);
}

// --- a directory, sealed as the files it holds: bin/sablier seal <dir> ---
// The findings signature covers what a scan found, the page signature one
// page. Neither covers data a project publishes — a month of measurements, a
// folder of evidence — and those are the files whose date a reader questions.
// The seal lists every file with its size and SHA-256, signs that list, and
// dates it the way a report is dated: tokens and a proof beside it.
//
// An unchanged directory keeps its seal, its tokens and its proof: the date
// worth having is the earliest one. A changed one is sealed again, the new
// seal names the digest of the old one, and the attestations of the old one
// are removed — they date files that are no longer these, and left beside the
// new seal they would read as a forgery. They remain in the history of
// whatever versions the directory.
if ($command === 'seal') {
    $dir = rtrim($argv[2] ?? '', '/');
    $key = 'ephemeral';
    $authorities = [];
    $calendars = [];
    foreach (\array_slice($argv, 3) as $arg) {
        if (preg_match('/^--sign=(.+)$/', $arg, $m) === 1) {
            $key = $m[1];
        } elseif (preg_match('/^--(timestamp|anchor)=(.+)$/', $arg, $m) === 1) {
            foreach (explode(',', $m[2]) as $url) {
                $url = trim($url);
                if ($url === '') {
                    continue;
                }
                if ($m[1] === 'timestamp' && !\in_array($url, $authorities, true)) {
                    $authorities[] = $url;
                } elseif ($m[1] === 'anchor' && !\in_array($url, $calendars, true)) {
                    $calendars[] = $url;
                }
            }
        }
    }
    if ($dir === '' || !is_dir($dir)) {
        fwrite(\STDERR, '✗ '.Lang::t('cli.seal_usage')."\n");
        exit(1);
    }
    if (Airgap::on() && $authorities !== []) {
        Airgap::refuse('--timestamp');
    }
    if (Airgap::on() && $calendars !== []) {
        Airgap::refuse('--anchor');
    }

    $inventory = Seal::inventory($dir);
    if ($inventory['refused'] !== []) {
        fwrite(\STDERR, '✗ '.Lang::t('files.refused', implode(', ', $inventory['refused']))."\n");
        exit(1);
    }
    if ($inventory['files'] === []) {
        fwrite(\STDERR, '✗ '.Lang::t('files.empty', $dir)."\n");
        exit(1);
    }
    $digest = Seal::digest($inventory['files']);
    $bytes = array_sum(array_map(static fn (array $f): int => $f['size'], $inventory['files']));

    $ephemeral = $key === 'ephemeral';
    $fingerprint = '';
    if ($ephemeral) {
        $pair = Signature::keypair();
        $pq = MlDsa::keypair();
        $secret = $pair['secret'];
        $pqSecret = $pq['secret'] ?? '';
        $fingerprint = Signature::fingerprint($pair['public'], $pq['public'] ?? '');
    } else {
        if (!is_file($key)) {
            fwrite(\STDERR, '✗ '.Lang::t('cli.key_missing', $key)."\n");
            exit(1);
        }
        $hybridKey = Signature::hybridKeyPath($key);
        $secret = trim((string) file_get_contents($key));
        $pqSecret = is_file($hybridKey) ? (string) file_get_contents($hybridKey) : '';
    }

    $path = Seal::path($dir);
    $base = Seal::base($dir);
    $existing = is_file($path) ? Value::map(json_decode((string) file_get_contents($path), true)) : [];
    $wasSeal = Value::string($existing['covers'] ?? null) === 'files';
    $raw = $ephemeral ? false : base64_decode($secret, true);
    $publicKey = \is_string($raw) && \strlen($raw) === \SODIUM_CRYPTO_SIGN_SECRETKEYBYTES
        ? base64_encode(sodium_crypto_sign_publickey_from_secretkey($raw))
        : '';

    if (!$ephemeral && $publicKey !== '' && $wasSeal
        && Value::string($existing['digest'] ?? null) === $digest
        && Value::string($existing['public_key'] ?? null) === $publicKey) {
        printf("  %s\n", Lang::t('files.kept', $path, Lang::number(\count($inventory['files'])), Lang::number($bytes), Timestamp::readable(Value::string($existing['signed_at'] ?? null))));
    } else {
        // What dated the files before is not about these files.
        if ($wasSeal) {
            $stale = [];
            foreach (Timestamp::paths($base) as $tokenPath) {
                $read = Timestamp::read((string) file_get_contents($tokenPath));
                if ($read === null || !hash_equals($read['imprint'], $digest)) {
                    $stale[] = $tokenPath;
                }
            }
            $proofPath = OpenTimestamps::path($base);
            if (is_file($proofPath)) {
                $held = OpenTimestamps::load($proofPath);
                if (!isset($held['proof']) || !hash_equals($held['proof']->hex(), $digest)) {
                    $stale[] = $proofPath;
                }
            }
            foreach ($stale as $stalePath) {
                unlink($stalePath);
                printf("  %s\n", Lang::t('files.stale', $stalePath));
            }
        }
        $block = ['covers' => 'files', 'files' => $inventory['files']] + Signature::sign(
            $digest,
            $secret,
            $wasSeal ? Value::string($existing['digest'] ?? null) : '',
            $pqSecret,
        );
        if ($ephemeral) {
            $block['ephemeral'] = true;
        }
        file_put_contents($path, json_encode($block, \JSON_PRETTY_PRINT | \JSON_UNESCAPED_SLASHES | \JSON_UNESCAPED_UNICODE)."\n");
        printf("  %s\n", Lang::t('files.written', $path, Lang::number(\count($inventory['files'])), Lang::number($bytes)));
        printf("  %s\n", Lang::t(isset($block['hybrid']) ? 'files.signed.hybrid' : 'files.signed.single', $digest));
    }
    sodium_memzero($secret);
    if ($pqSecret !== '') {
        sodium_memzero($pqSecret);
    }

    foreach (sablier_attest_tokens($base, $digest, $authorities) as $token) {
        printf("  %s\n", Lang::t('files.attested', Timestamp::readable($token['time']), $token['authority'] !== '' ? $token['authority'] : $token['path']));
    }
    if ($calendars !== []) {
        $anchor = sablier_attest_anchor($base, $digest, $calendars);
        if ($anchor !== null) {
            printf("  %s\n", $anchor['state'] === 'anchored'
                ? Lang::t('files.anchored', $anchor['height'], OpenTimestamps::readable($anchor['time']))
                : Lang::t('files.pending', $anchor['path']));
        }
    }

    if ($fingerprint !== '') {
        printf("\n  %s\n\n    %s\n\n  %s\n", Lang::t('files.ephemeral.done'), $fingerprint, Lang::t('cli.endorse_send'));
    }
    printf("\n  %s\n", Lang::t('files.verify_hint', $path));
    exit(0);
}

if ($command === 'verify') {
    $signaturePath = $argv[2] ?? '';
    $declarePath = null;
    $claimed = '';
    $jsonPath = '';
    foreach (\array_slice($argv, 3) as $arg) {
        if (preg_match('/^--declare=(.+)$/', $arg, $m) === 1) {
            $declarePath = $m[1];
        } elseif (preg_match('/^--fingerprint=(.+)$/', $arg, $m) === 1) {
            $claimed = $m[1];
        } elseif (preg_match('/^--json=(.+)$/', $arg, $m) === 1) {
            $jsonPath = $m[1];
        }
    }
    if (!is_file($signaturePath)) {
        fwrite(\STDERR, '✗ '.Lang::t('cli.verify_usage')."\n");
        exit(1);
    }

    $block = Value::map(json_decode((string) file_get_contents($signaturePath), true));
    $declaration = $declarePath !== null ? Declaration::load($declarePath) : null;

    // A page signature on its own: the page against the file beside it, with
    // the keys the declaration names — or, failing that, the keys of the
    // findings signature filed beside the same page, when there is one.
    if (Value::string($block['covers'] ?? null) === 'page') {
        $beside = (string) preg_replace('/\.page\.sig$/', '', $signaturePath).'.sig';
        $report = is_file($beside) ? Value::map(json_decode((string) file_get_contents($beside), true)) : [];
        $held = sablier_page_check($signaturePath, $block, $report, $declaration?->signingPublicKey, $declaration?->signingPublicKeyPq, true);
        if ($claimed !== '') {
            $actual = Signature::fingerprint(
                Value::string($block['public_key'] ?? null),
                Value::string(Value::map($block['hybrid'] ?? null)['public_key'] ?? null),
            );
            $normalise = static fn (string $v): string => strtoupper((string) preg_replace('/[^0-9A-Fa-f]/', '', $v));
            $same = hash_equals($normalise($actual), $normalise($claimed));
            printf("  %s\n", Lang::t($same ? 'seal.fingerprint.match' : 'seal.fingerprint.differs', $actual));
            $held = $held && $same;
        }
        exit($held ? 0 : 1);
    }

    // An endorsement covers the declaration it sits beside, so the digest can
    // be recomputed here rather than taken on trust from the file that claims
    // it. Without the declaration there is nothing to recompute, and the
    // command says that instead of reporting a signature as verified when only
    // half of it was.
    if (Value::string($block['covers'] ?? null) === 'declaration') {
        if ($declaration === null) {
            fwrite(\STDERR, '✗ '.Lang::t('cli.verify_needs_declaration')."\n");
            exit(1);
        }
        $endorsement = $declaration->endorsement();
        printf("  %s\n", Lang::t($endorsement === null ? 'verify.incomplete' : $endorsement['reason']));
        if ($endorsement !== null) {
            printf("  %s\n", Lang::t('cli.endorse_state', $endorsement['signed_at'], $endorsement['fingerprint']));
        }
        exit($endorsement !== null && $endorsement['valid'] ? 0 : 1);
    }

    // What a program reading the result needs, beside what a person reads:
    // `--json=FILE` writes it whatever the outcome, so a dashboard can show
    // the date a seal was checked and what that check said, in its own words,
    // without parsing sentences that change with the language.
    $summary = [
        'checked_at' => (new \DateTimeImmutable())->format(\DateTimeInterface::ATOM),
        'sablier' => Version::NUMBER,
        'covers' => Value::string($block['covers'] ?? null, 'findings'),
        'digest' => Value::string($block['digest'] ?? null),
        'signed_at' => Value::string($block['signed_at'] ?? null),
        'previous' => Value::string($block['previous'] ?? null),
        'signature' => [],
        'timestamps' => [],
        'anchors' => [],
        'pending' => [],
    ];
    // Filled as the checks run, and joined to the summary at the end.
    /** @var list<array<string, int|string>> $timestampsSeen */
    $timestampsSeen = [];
    /** @var list<array<string, int|string>> $anchorsSeen */
    $anchorsSeen = [];
    $finish = static function (bool $held) use (&$summary, &$timestampsSeen, &$anchorsSeen, $jsonPath): never {
        if ($jsonPath !== '') {
            $summary['timestamps'] = $timestampsSeen;
            $summary['anchors'] = $anchorsSeen;
            $summary['valid'] = $held;
            file_put_contents($jsonPath, json_encode($summary, \JSON_PRETTY_PRINT | \JSON_UNESCAPED_SLASHES | \JSON_UNESCAPED_UNICODE)."\n");
        }
        exit($held ? 0 : 1);
    };

    // A seal covers the files of the directory it sits in. Its list is in
    // the file for the reader, and recomputed into the digest the signature
    // covers: a list edited by hand fails as an altered signature, before any
    // file on disk is compared with it.
    $sealed = null;
    $filesHeld = true;
    if ($summary['covers'] === 'files') {
        $sealed = Seal::listed($block);
        if ($sealed === null) {
            printf("  ✗ %s\n", Lang::t('files.verify.unreadable', $signaturePath));
            $summary['files'] = ['state' => 'unreadable'];
            $finish(false);
        }
    }

    $expectedKey = $declaration?->signingPublicKey;
    $expectedPqKey = $declaration?->signingPublicKeyPq;
    $previous = Value::string($block['previous'] ?? null);
    /** @var array<string, mixed> $hybridClaim */
    $hybridClaim = Value::map($block['hybrid'] ?? null);
    $result = Signature::verify([
        'algorithm' => Value::string($block['algorithm'] ?? null),
        'digest' => Value::string($block['digest'] ?? null),
        'signed_at' => Value::string($block['signed_at'] ?? null),
        'public_key' => Value::string($block['public_key'] ?? null),
        'signature' => Value::string($block['signature'] ?? null),
        'previous' => $previous,
        'hybrid' => $hybridClaim,
    ], $sealed !== null ? Seal::digest($sealed) : null, $expectedKey, $expectedPqKey);

    // "The findings changed" is about a report; for a seal, the list it signs
    // is what no longer matches its digest.
    printf("  %s\n", Lang::t($sealed !== null && $result['reason'] === 'verify.changed' ? 'files.verify.list_altered' : $result['reason']));
    $summary['signature'] = [
        'valid' => $result['valid'],
        'reason' => $result['reason'],
        'algorithm' => Value::string($block['algorithm'] ?? null),
        'hybrid' => $hybridClaim !== [] ? ($result['hybrid'] ?? 'unavailable') : 'none',
        'hybrid_algorithm' => Value::string($hybridClaim['algorithm'] ?? null),
        'fingerprint' => Signature::fingerprint(Value::string($block['public_key'] ?? null), Value::string($hybridClaim['public_key'] ?? null)),
        'ephemeral' => ($block['ephemeral'] ?? false) === true,
    ];

    // The sky of the keys, named. The signed page draws it under its seal and
    // the Threema message carries its name, but a page draws what it likes:
    // this is the one place the name is computed from the keys by the reader's
    // own copy of the tool. Only under a signature that holds — the keys of a
    // file that failed are nobody's, and naming them would lend them a face.
    // A matching name is a hint and never the check: it is some 33 bits, and
    // `--fingerprint` just below is what compares the keys.
    $sky = (new Sky(Signature::keysHash(Value::string($block['public_key'] ?? null), Value::string($hybridClaim['public_key'] ?? null))))->name;
    $summary['signature']['sky'] = $sky;

    // The keys in this file against the line that came by another road. With an
    // ephemeral key there is nothing else to compare them to: the channel is
    // what proves who signed, and this is where the two meet.
    if ($claimed !== '') {
        $actual = Signature::fingerprint(
            Value::string($block['public_key'] ?? null),
            Value::string($hybridClaim['public_key'] ?? null),
        );
        $normalise = static fn (string $v): string => strtoupper((string) preg_replace('/[^0-9A-Fa-f]/', '', $v));
        $same = hash_equals($normalise($actual), $normalise($claimed));
        printf("  %s\n", Lang::t($same ? 'seal.fingerprint.match' : 'seal.fingerprint.differs', $actual));
        if (!$same) {
            $finish(false);
        }
    }

    // Which signatures the file carries, and which of them this machine could
    // check. A reader who cannot run ML-DSA must know that, not guess it.
    if ($hybridClaim !== []) {
        printf("  %s\n", Lang::t(match ($result['hybrid'] ?? '') {
            'valid' => 'verify.hybrid.valid',
            'invalid' => 'verify.hybrid.invalid',
            'unchecked' => 'verify.hybrid.unchecked',
            default => 'verify.hybrid.unavailable',
        }, Value::string($hybridClaim['algorithm'] ?? null)));
    } else {
        printf("  %s\n", Lang::t('verify.hybrid.none'));
    }

    // Printed here, under the lines that say which signatures hold, rather
    // than between them.
    if ($result['valid']) {
        printf("  %s\n", Lang::t('verify.sky', $sky));
    }

    // The files themselves, against the list. Each difference is named, with
    // its kind: a file changed, gone, or added since the seal was made.
    if ($sealed !== null) {
        $present = Seal::inventory(dirname($signaturePath));
        $diff = Seal::compare($sealed, $present['files']);
        $bytes = array_sum(array_map(static fn (array $f): int => $f['size'], $sealed));
        foreach ($diff['modified'] as $file) {
            printf("  ✗ %s\n", Lang::t('files.verify.modified', $file['path'], Lang::number($file['sealed']), Lang::number($file['size'])));
        }
        foreach ($diff['missing'] as $file) {
            printf("  ✗ %s\n", Lang::t('files.verify.missing', $file));
        }
        foreach ($diff['added'] as $file) {
            printf("  ✗ %s\n", Lang::t('files.verify.added', $file));
        }
        foreach ($present['refused'] as $file) {
            printf("  ✗ %s\n", Lang::t('files.verify.link', $file));
        }
        $filesHeld = $diff['modified'] === [] && $diff['missing'] === [] && $diff['added'] === [] && $present['refused'] === [];
        if ($filesHeld) {
            printf("  %s\n", Lang::t('files.verify.match', Lang::number(\count($sealed)), Lang::number($bytes)));
        }
        $summary['files'] = [
            'state' => $filesHeld ? 'match' : 'differs',
            'count' => \count($sealed),
            'bytes' => $bytes,
            'modified' => array_map(static fn (array $f): string => $f['path'], $diff['modified']),
            'missing' => $diff['missing'],
            'added' => [...$diff['added'], ...$present['refused']],
        ];
    }

    // The date, when somebody else attested it. Found beside the signature
    // without a flag, for the same reason the chain is: an artefact that has to
    // be asked for is an artefact nobody checks.
    $tokenPath = '';
    $tokenCa = '';
    foreach (\array_slice($argv, 3) as $argument) {
        if (preg_match('/^--timestamp=(.+)$/', $argument, $m) === 1) {
            $tokenPath = $m[1];
        } elseif (preg_match('/^--timestamp-ca=(.+)$/', $argument, $m) === 1) {
            $tokenCa = $m[1];
        }
    }
    // Every token beside the signature, not the first one. A reader handed
    // three attestations and a command that checks one would verify a third of
    // what they hold, and conclude the whole of it was fine.
    $tokenPaths = $tokenPath !== ''
        ? [$tokenPath]
        : Timestamp::paths((string) preg_replace('/\.sig$/', '', $signaturePath));
    $attestedFailed = false;
    foreach ($tokenPaths as $tokenPath) {
        if (!is_file($tokenPath)) {
            continue;
        }
        $token = (string) file_get_contents($tokenPath);
        $read = Timestamp::read($token);
        $state = Timestamp::verify($token, Value::string($block['digest'] ?? null), $tokenCa);
        if ($read === null) {
            printf("  %s\n", Lang::t('verify.timestamp.unreadable', $tokenPath));
            $attestedFailed = true;
        } else {
            printf("  %s\n", Lang::t(
                'verify.timestamp.'.$state['state'],
                Timestamp::readable($read['time']),
                $read['authority'] !== '' ? $read['authority'] : $tokenPath,
                $state['detail'],
            ));
            // An unverifiable chain is not a forgery, so it does not fail the
            // command — it prints what would make it checkable.
            if ($state['state'] === 'untrusted') {
                printf("  %s\n", Lang::t('verify.timestamp.hint'));
            }
            if ($state['state'] === 'valid') {
                printf("  %s\n", $read['algorithm'] !== ''
                    ? Lang::t('verify.timestamp.limit', $read['algorithm'])
                    : Lang::t('verify.timestamp.limit.unnamed'));
            }
            // One invalid token condemns the set: it is the state that says a
            // token attests something other than this document.
            $attestedFailed = $attestedFailed || $state['state'] === 'invalid';
        }
        $timestampsSeen[] = [
            'file' => basename($tokenPath),
            'state' => $read === null ? 'unreadable' : $state['state'],
            'time' => $read === null ? '' : sablier_iso($read['time']),
            'authority' => $read['authority'] ?? '',
            'algorithm' => $read['algorithm'] ?? '',
        ];
    }

    // The anchoring, when there is a proof beside the signature. Discovered
    // like the tokens, and bound to this signature the same way: a proof is
    // first checked to be about this digest, before any question of blocks.
    $anchorPath = (string) preg_replace('/\.sig$/', '', $signaturePath).'.ots';
    foreach (\array_slice($argv, 3) as $argument) {
        if (preg_match('/^--anchor=(.+)$/', $argument, $m) === 1) {
            $anchorPath = $m[1];
        }
    }
    if (is_file($anchorPath)) {
        $loaded = OpenTimestamps::load($anchorPath);
        if (isset($loaded['error'])) {
            printf("  ✗ %s\n", Lang::t($loaded['error'], $loaded['detail']));
            $attestedFailed = true;
            $anchorsSeen[] = ['state' => 'unreadable', 'height' => 0, 'time' => '', 'source' => ''];
        } elseif (!hash_equals(strtolower(Value::string($block['digest'] ?? null)), $loaded['proof']->hex())) {
            printf("  ✗ %s\n", Lang::t('verify.anchor.other_digest', $anchorPath));
            $attestedFailed = true;
            $anchorsSeen[] = ['state' => 'other_digest', 'height' => 0, 'time' => '', 'source' => ''];
        } else {
            $found = [];
            $attestedFailed = sablier_anchor_check($anchorPath, $loaded['proof'], \array_slice($argv, 3), $found) || $attestedFailed;
            foreach ($found['anchors'] ?? [] as $anchor) {
                $anchorsSeen[] = [
                    'state' => $anchor['state'],
                    'height' => $anchor['height'],
                    'time' => $anchor['time'] > 0 ? gmdate(\DateTimeInterface::ATOM, $anchor['time']) : '',
                    'source' => $anchor['source'],
                ];
            }
            $summary['pending'] = $found['pending'] ?? [];
        }
    }

    // The link, when the block claims one. Given the earlier signature, it is
    // checked; given nothing, it is still printed, because a reader holding
    // one file should know another exists.
    if ($previous !== '') {
        $earlier = null;
        foreach (\array_slice($argv, 3) as $argument) {
            if (preg_match('/^--previous=(.+)$/', $argument, $m) === 1) {
                $earlier = Signature::previousDigest($m[1]);
            }
        }

        printf("  %s\n", $earlier === null
            ? Lang::t('verify.previous', substr($previous, 0, 16))
            : Lang::t($earlier === $previous ? 'verify.previous.match' : 'verify.previous.mismatch', substr($previous, 0, 16)));
        if ($earlier !== null && $earlier !== $previous) {
            $finish(false);
        }
    }

    // A seal covers its files, which were compared above; there is no page.
    if ($sealed !== null) {
        $finish($result['valid'] && !$attestedFailed && $filesHeld);
    }

    // The page, when its own signature is filed beside it. The findings
    // signature cannot cover the page that displays it; this one does, so a
    // single character changed in the page fails here. A report made before
    // page signatures existed has none, and is told so rather than failed.
    $pageSignature = Signature::pagePath((string) preg_replace('/\.sig$/', '', $signaturePath));
    $pageHeld = true;
    if (is_file($pageSignature)) {
        $pageHeld = sablier_page_check(
            $pageSignature,
            Value::map(json_decode((string) file_get_contents($pageSignature), true)),
            $block,
            $expectedKey,
            $expectedPqKey,
        );
    } else {
        printf("  %s\n", Lang::t('verify.page.none', basename($pageSignature)));
    }

    $finish($result['valid'] && !$attestedFailed && $pageHeld);
}

// --- an OpenTimestamps proof on its own: bin/sablier anchor <file.ots> ----
// `verify` checks the proof it finds beside a signature. This is the same
// check for a reader who holds only the proof — or a proof this tool did not
// make: it names the digest the file covers, completes it when the calendars
// have, and checks every block it claims.
//
// Handed any other file, it anchors that file: its SHA-256 goes to the
// calendars and the proof is written beside it as <file>.ots, the name the
// official client uses. That is how this project dates its own release
// archives, and a date worth having for one file is worth having for others —
// a SBOM, a signed declaration, minutes. A proof already beside the file that
// covers these very bytes is kept and only completed: the oldest anchoring is
// the one worth having, as everywhere else in this tool.
if ($command === 'anchor') {
    $path = $argv[2] ?? '';
    if (!is_file($path)) {
        fwrite(\STDERR, '✗ '.Lang::t('cli.anchor_usage')."\n");
        exit(1);
    }
    if (!str_ends_with($path, '.ots')) {
        $proofPath = $path.'.ots';
        $digest = (string) hash_file('sha256', $path);
        if (is_file($proofPath)) {
            $held = OpenTimestamps::load($proofPath);
            if (isset($held['proof']) && hash_equals($held['proof']->hex(), $digest)) {
                printf("  %s\n", Lang::t('anchor.file.kept', $proofPath));
                exit(sablier_anchor_check($proofPath, $held['proof'], \array_slice($argv, 3)) ? 1 : 0);
            }
            // Never overwritten: a proof for other bytes is somebody's evidence
            // about something, and the file it dated may be the one that changed.
            fwrite(\STDERR, '✗ '.Lang::t('anchor.file.other', $proofPath, $path)."\n");
            exit(1);
        }
        if (Airgap::on()) {
            Airgap::refuse('anchor');
        }
        $asked = [];
        foreach (\array_slice($argv, 3) as $arg) {
            if (preg_match('/^--anchor=(.+)$/', $arg, $m) === 1) {
                foreach (explode(',', $m[1]) as $calendar) {
                    $asked[] = trim($calendar);
                }
            }
        }
        $stamped = OpenTimestamps::stamp($digest, OpenTimestamps::calendars($asked === [] ? [OpenTimestamps::KEYWORD] : $asked));
        foreach ($stamped['errors'] as $error) {
            fwrite(\STDERR, '✗ '.Lang::t($error['error'], $error['detail'])."\n");
        }
        if ($stamped['proof'] === null) {
            exit(1);
        }
        file_put_contents($proofPath, $stamped['proof']->serialise());
        printf("  %s\n", Lang::t('anchor.file.stamped', $proofPath, $digest, implode(', ', $stamped['reached'])));
        exit(0);
    }
    $loaded = OpenTimestamps::load($path);
    if (isset($loaded['error'])) {
        fwrite(\STDERR, '✗ '.Lang::t($loaded['error'], $loaded['detail'])."\n");
        exit(1);
    }
    printf("  %s\n", Lang::t('verify.anchor.digest', $path, $loaded['proof']->hex()));
    exit(sablier_anchor_check($path, $loaded['proof'], \array_slice($argv, 3)) ? 1 : 0);
}

// --- accept a finding: bin/sablier accept <fingerprint> -----------------
// The command-line twin of the report's button. It writes a decision into a
// versioned file, which is what makes it reviewable; it never hides anything.
if ($command === 'accept') {
    $fingerprint = $argv[2] ?? '';
    $reason = '';
    $until = (new \DateTimeImmutable('+6 months'))->format('Y-m-d');
    $file = 'sablier.json';
    foreach (\array_slice($argv, 3) as $arg) {
        if (preg_match('/^--(reason|until|declare)=(.+)$/', $arg, $m) === 1) {
            ${$m[1] === 'declare' ? 'file' : $m[1]} = $m[2];
        }
    }

    if (preg_match('/^[0-9a-f]{8}$/', $fingerprint) !== 1 || trim($reason) === '') {
        fwrite(\STDERR, '✗ '.Lang::t('cli.accept_usage')."\n");
        exit(1);
    }
    if (\DateTimeImmutable::createFromFormat('Y-m-d', $until) === false) {
        fwrite(\STDERR, '✗ '.Lang::t('cli.accept_bad_date')."\n");
        exit(1);
    }

    $data = is_file($file) ? json_decode((string) file_get_contents($file), true) : [];
    if (!\is_array($data)) {
        fwrite(\STDERR, '✗ '.Lang::t('cli.accept_unreadable', $file)."\n");
        exit(1);
    }
    $accepted = Value::map($data['accepted'] ?? null);
    $accepted[$fingerprint] = ['reason' => trim($reason), 'until' => $until];
    $data['accepted'] = $accepted;
    file_put_contents($file, json_encode($data, \JSON_PRETTY_PRINT | \JSON_UNESCAPED_UNICODE | \JSON_UNESCAPED_SLASHES)."\n");

    printf("  %s\n", Lang::t('cli.accept_written', $fingerprint, $until, $file));
    exit(0);
}

// --- a declaration to correct: bin/sablier init <path> ------------------
// The starter file, copied with the two things a machine can honestly fill:
// the project's name and today's date. Everything else is a proposal to argue
// with, which is the point — correcting a draft surfaces the disagreements a
// blank file hides.
if ($command === 'init') {
    $target = $argv[2] ?? '.';
    $root = realpath($target);
    if ($root === false || !is_dir($root)) {
        fwrite(\STDERR, '✗ '.Lang::t('cli.missing_path')."\n");
        exit(1);
    }

    $out = $root.'/sablier.json';
    foreach (\array_slice($argv, 3) as $argument) {
        if (preg_match('/^--out=(.+)$/', $argument, $m) === 1) {
            $out = $m[1];
        }
    }

    // Never over a declaration that exists: it holds decisions somebody made,
    // and this command has nothing to add to them.
    if (is_file($out)) {
        fwrite(\STDERR, '✗ '.Lang::t('cli.init_exists', $out)."\n");
        exit(1);
    }

    $starter = Value::map(json_decode((string) @file_get_contents(__DIR__.'/../examples/starter.json'), true));
    if ($starter === []) {
        fwrite(\STDERR, '✗ '.Lang::t('cli.init_unreadable')."\n");
        exit(1);
    }

    $starter['project'] = basename($root);
    $starter['deadlines_checked_on'] = (new \DateTimeImmutable())->format('Y-m-d');
    file_put_contents($out, json_encode($starter, \JSON_PRETTY_PRINT | \JSON_UNESCAPED_SLASHES | \JSON_UNESCAPED_UNICODE)."\n");

    printf("\n  %s\n  %s\n\n", Lang::t('cli.init_written', $out), Lang::t('cli.init_next'));
    exit(0);
}

// --- the interview in a browser: bin/sablier serve <path> ---------------
// The terminal version works and nobody should have to use it in front of a
// client. Same questions, same file written at the end, one subject per page
// and a clock the person can see.
if ($command === 'serve') {
    $target = $argv[2] ?? '';
    $port = 8765;
    $host = '127.0.0.1';
    $out = null;
    $expose = false;
    $public = null;
    foreach (\array_slice($argv, 3) as $argument) {
        if ($argument === '--expose') {
            $expose = true;
        } elseif (preg_match('/^--out=(.+)$/', $argument, $m) === 1) {
            $out = $m[1];
        } elseif (preg_match('/^--port=(\d{2,5})$/', $argument, $m) === 1) {
            $port = (int) $m[1];
        } elseif (preg_match('/^--host=([\d.:a-fA-F]+)$/', $argument, $m) === 1) {
            $host = $m[1];
        } elseif (preg_match('#^--public=(https?://[^\s?]+)/?$#', $argument, $m) === 1) {
            $public = $m[1];
            $expose = true;
        }
    }

    $root = $target !== '' ? realpath($target) : false;
    if ($root === false || !is_dir($root)) {
        fwrite(\STDERR, '✗ '.Lang::t('cli.missing_path')."\n");
        exit(1);
    }

    $out ??= $root.'/sablier.json';
    $declaration = Declaration::load(is_file($out) ? $out : null);
    $scan = sablier_scanner($declaration)->scan($root);
    $findings = (new Assessor($declaration, (int) date('Y')))->assess($scan['findings']);
    $areas = Interview::areas($findings, $declaration);

    if ($areas === []) {
        printf("\n  %s\n\n", Lang::t('declare.nothing'));
        exit(0);
    }

    $directory = sys_get_temp_dir().'/sablier-web-'.bin2hex(random_bytes(4));
    @mkdir($directory, 0o755, true);
    $sessionFile = $directory.'/session.json';
    Session::create($sessionFile, [
        'target' => $root,
        // The name the client uses for the thing being audited. "This
        // application" means nothing to somebody who runs four of them.
        'project' => $declaration->project !== '' ? $declaration->project : basename($root),
        'out' => $out,
        'log' => \dirname($out).'/session.json',
        'report' => $directory.'/report.html',
        'areas' => $areas,
        // Read once, here: the questions are worded against it and a subprocess
        // per screen would be a subprocess per screen.
        'started_in' => Interview::startedIn($root),
        'index' => 0,
        'answers' => [],
        'record' => [],
        'context' => [],
    ]);

    // A token the moment the server leaves the loopback. It is not
    // authentication — anyone the link reaches can answer — but an interview
    // that writes a declaration and runs a scan has no business being open to
    // whoever guesses the port.
    // Reached from outside, one way or another. A bind address is a bad judge of
    // that: behind an SSH tunnel and a reverse proxy the server stays on the
    // loopback and the link is still public, so the operator can say so with
    // --expose, and --public says it by naming the address being handed over.
    $local = \in_array($host, ['127.0.0.1', '::1', 'localhost'], true) && !$expose;
    $token = $local ? '' : bin2hex(random_bytes(8));
    Session::open($sessionFile)?->set('token', $token);

    $url = ($public ?? 'http://'.$host.':'.$port).'/'.($token !== '' ? '?k='.$token : '');
    printf("\n  %s\n", Lang::t('web.serving', $url));
    if (!$local) {
        printf("  %s\n", Lang::t('web.serving.exposed'));
    }
    printf("  %s\n\n", Lang::t('web.serving.stop'));

    // Opening the browser is a convenience for a person, and a nuisance for
    // everything else. The test suite starts this server twice per run, and on
    // a developer's machine that was two windows every time the suite ran —
    // reported as a bug, and rightly. A pipe instead of a terminal says nobody
    // is watching, so nothing is opened.
    $watched = !\function_exists('posix_isatty') || @posix_isatty(\STDOUT);
    foreach ($local && $public === null && $watched ? ['open', 'xdg-open'] : [] as $opener) {
        if (trim((string) @shell_exec('command -v '.escapeshellarg($opener).' 2>/dev/null')) !== '') {
            @shell_exec(\sprintf('%s %s >/dev/null 2>&1 &', $opener, escapeshellarg($url)));
            break;
        }
    }

    // Where php -S binds, which is --host except in a container. Run through
    // the launcher without a local PHP, the server must listen on every
    // interface of the container for the published port to reach it, while
    // --host keeps meaning what it means to the person: the address on their
    // machine, which the launcher publishes on and which decides the token.
    $listen = getenv('SABLIER_LISTEN');
    $listen = \is_string($listen) && preg_match('/^[\d.:a-fA-F]+$/', $listen) === 1 ? $listen : $host;

    // exec, so the server replaces the shell instead of hiding behind it: a
    // stray php -S holding the port after its parent was killed is a bad way
    // to learn that the command leaked a process.
    $command = \sprintf(
        'exec env SABLIER_SESSION=%s SABLIER_LANG=%s %s -S %s:%d %s 2>/dev/null',
        escapeshellarg($sessionFile),
        escapeshellarg(Lang::locale()),
        escapeshellarg(\PHP_BINARY),
        // Safe today because --host= only accepts an address-shaped string, two
        // hundred lines above. Escaped anyway: a shell command whose safety
        // rests on a regex somewhere else is one edit away from not being safe.
        escapeshellarg($listen),
        $port,
        escapeshellarg(__DIR__.'/../src/Web/router.php'),
    );
    passthru($command);
    exit(0);
}

// --- the interview: bin/sablier declare <path> --------------------------
// The only command in this tool meant to be run with somebody else in the
// room, and the only one whose output is a question rather than a verdict. It
// asks about retention and about harm — two things a person answers every
// week — and derives the lifetime nobody can state directly.
// --- the interview as one file: bin/sablier worksheet <path> ------------
// For a room with no network, a client who will not run a command, or a machine
// nobody may connect to. The questions and the subjects are baked in; the
// answers come back as a file, and the report is built here afterwards.
if ($command === 'worksheet') {
    $target = $argv[2] ?? '';
    $out = null;
    foreach (\array_slice($argv, 3) as $argument) {
        if (preg_match('/^--out=(.+)$/', $argument, $m) === 1) {
            $out = $m[1];
        }
    }

    $root = $target !== '' ? realpath($target) : false;
    if ($root === false || !is_dir($root)) {
        fwrite(\STDERR, '✗ '.Lang::t('cli.missing_path')."\n");
        exit(1);
    }

    $declaration = Declaration::load(is_file($root.'/sablier.json') ? $root.'/sablier.json' : null);
    $scan = sablier_scanner($declaration)->scan($root);
    $findings = (new Assessor($declaration, (int) date('Y')))->assess($scan['findings']);
    $areas = Interview::areas($findings, $declaration);
    if ($areas === []) {
        printf("\n  %s\n\n", Lang::t('declare.nothing'));
        exit(0);
    }

    $out ??= 'worksheet.html';
    $project = $declaration->project !== '' ? $declaration->project : basename($root);
    // The project's own history, so the questions can be anchored on years the
    // person lived through rather than on spans nobody estimates well.
    file_put_contents($out, Worksheet::render($project, $areas, date('Y-m-d'), Interview::startedIn($root)));
    printf("\n  %s\n\n", Lang::t('worksheet.written', $out));
    exit(0);
}

if ($command === 'declare') {
    $target = $argv[2] ?? '';
    $out = null;
    $log = null;
    $import = null;
    foreach (\array_slice($argv, 3) as $argument) {
        if (preg_match('/^--out=(.+)$/', $argument, $m) === 1) {
            $out = $m[1];
        } elseif (preg_match('/^--log=(.+)$/', $argument, $m) === 1) {
            $log = $m[1];
        } elseif (preg_match('/^--import=(.+)$/', $argument, $m) === 1) {
            $import = $m[1];
        }
    }

    $root = $target !== '' ? realpath($target) : false;
    if ($root === false || !is_dir($root)) {
        fwrite(\STDERR, '✗ '.Lang::t('cli.missing_path')."\n");
        exit(1);
    }

    $out ??= $root.'/sablier.json';
    $declaration = Declaration::load(is_file($out) ? $out : null);
    $scan = sablier_scanner($declaration)->scan($root);

    $findings = (new Assessor($declaration, (int) date('Y')))->assess($scan['findings']);
    $areas = Interview::areas($findings, $declaration);

    // Answers filled in elsewhere — the single-file worksheet, on a machine
    // with no network. They go through the same merge as the ones typed here,
    // because a second answer carrying a name already used means the same thing
    // wherever it was given.
    if ($import !== null) {
        $payload = Value::map(json_decode((string) @file_get_contents($import), true));
        $answers = [];
        foreach (Value::map($payload['answers'] ?? null) as $entry) {
            $answer = Value::map($entry);
            $name = trim(Value::string($answer['name'] ?? null));
            if ($name === '') {
                continue;
            }
            $answers[] = [
                'name' => $name,
                'paths' => Value::strings($answer['paths'] ?? null),
                'lifetime' => Value::int($answer['lifetime'] ?? null),
                'note' => Value::string($answer['note'] ?? null),
                'trust_anchor' => ($answer['trust_anchor'] ?? false) === true,
                'declared_by' => Value::string($answer['declared_by'] ?? null),
            ];
        }

        if ($answers === []) {
            fwrite(\STDERR, '✗ '.Lang::t('worksheet.import.unreadable', $import)."\n");
            exit(1);
        }

        /** @var array<string, mixed> $existing */
        $existing = is_file($out) ? Value::map(json_decode((string) file_get_contents($out), true)) : [];
        /** @var array<string, mixed> $context */
        $context = Value::map($payload['context'] ?? null);
        unset($context['who']);
        /** @var array<string, mixed> $base */
        $base = [...$existing, ...$context];
        $merged = Interview::merge($base, $answers);
        file_put_contents($out, json_encode($merged, \JSON_PRETTY_PRINT | \JSON_UNESCAPED_SLASHES | \JSON_UNESCAPED_UNICODE)."\n");

        $log ??= \dirname($out).'/session.json';
        file_put_contents($log, json_encode([
            'project' => basename($root),
            'finished_at' => (new \DateTimeImmutable())->format(\DateTimeInterface::ATOM),
            'answered' => \count($answers),
            'source' => basename($import),
            'record' => Value::map($payload['record'] ?? null),
            'feedback' => Value::map($payload['feedback'] ?? null),
        ], \JSON_PRETTY_PRINT | \JSON_UNESCAPED_SLASHES | \JSON_UNESCAPED_UNICODE)."\n");

        printf("\n  %s\n", Lang::t('worksheet.imported', \count($answers), basename($import)));
        printf("  → %s\n  → %s\n", $out, $log);

        // What the answers look like, said out loud rather than filed. An
        // import that prints "7 answers taken" and nothing else turns seven
        // clicks into a declaration somebody will be held to.
        if (Interview::uniform($answers)) {
            printf("\n  ⚠ %s\n", wordwrap(Lang::t('worksheet.uniform', \count($answers), $answers[0]['lifetime']), 76, "\n    "));
        }
        $imported = Declaration::load($out);
        foreach ($imported->overlaps() as $overlap) {
            printf("\n  ⚠ %s\n", wordwrap(Lang::t(
                'declare.overlap',
                $overlap['shadowed'], $overlap['glob'], $overlap['kept'], $overlap['shadowed'],
            ), 76, "\n    "));
        }
        if ($imported->audit['client'] === '' && Value::string(Value::map($payload['context'] ?? null)['who'] ?? null) === '') {
            printf("\n  ⚠ %s\n", wordwrap(Lang::t('worksheet.nobody'), 76, "\n    "));
        }
        // The regime is not asked of the person being interviewed: nobody
        // outside the field picks between NIST IR 8547, CNSA 2.0 and an ANSSI
        // position. It is the auditor's to set, so the auditor is told.
        if ($imported->regime === 'general') {
            printf("\n  · %s\n", wordwrap(Lang::t('cli.regime_yours', $imported->expiryYear), 76, "\n    "));
        }
        printf("\n");
        exit(0);
    }

    printf("\n  %s\n\n", Lang::t('declare.intro'));
    if ($areas === []) {
        printf("  %s\n\n", Lang::t('declare.nothing'));
        exit(0);
    }
    printf("  %s\n", Lang::t('declare.found', \count($areas)));
    printf("  %s\n", Lang::t('declare.target', basename($root)));

    // The hint and the examples are shown on the first subject and never
    // again: a person reads them once, and repeating them twelve times turns
    // the screen into a form rather than a conversation.
    $first = true;
    $ask = static function (string $question, bool $optional = false, bool $hint = false): ?string {
        while (true) {
            printf("\n  %s\n", $question);
            if ($optional && $hint) {
                printf("  %s\n", Lang::t('declare.q.skip'));
            }
            $line = fgets(\STDIN);
            if ($line === false) {
                return null;
            }
            $line = trim($line);
            if ($line !== '' || $optional) {
                return $line === '' ? null : $line;
            }
        }
    };

    $years = static function (string $question, bool $hint = false) use ($ask): ?int {
        while (true) {
            $answer = $ask($question, true, $hint);
            if ($answer === null) {
                return null;
            }
            if (preg_match('/^\d{1,3}$/', $answer) === 1) {
                return (int) $answer;
            }
            printf("  %s\n", Lang::t('declare.invalid'));
        }
    };

    $startedAt = microtime(true);

    // A duration and a date are not the same question, and a validator that
    // confuses them rejects "2032" as too long to be a number of years.
    $calendarYear = static function (string $question) use ($ask): ?int {
        while (true) {
            $answer = $ask($question, true, true);
            if ($answer === null) {
                return null;
            }
            if (preg_match('/^(20|21)\d{2}$/', $answer) === 1) {
                return (int) $answer;
            }
            printf("  %s\n", Lang::t('declare.invalid.year'));
        }
    };

    // Two questions about the system rather than about its data, asked once.
    // They move every verdict below them: how long the thing will keep writing
    // secrets, and whose deadline it answers to.
    $project = [];
    $serviceUntil = $calendarYear(Lang::t('declare.q.service'));
    if ($serviceUntil !== null) {
        $project['service_until'] = $serviceUntil;
        printf("  %s\n", Lang::t('declare.service.set', $serviceUntil));
    } else {
        printf("  %s\n", Lang::t('declare.service.unknown'));
    }

    $chosen = $ask(Lang::t('declare.q.regime'), true, true);
    $regime = match ($chosen) {
        '2' => 'anssi',
        '3' => 'nss',
        '1' => 'general',
        default => null,
    };
    if ($regime !== null) {
        $project['regime'] = $regime;
        printf("  %s\n", Lang::t('declare.regime.set',
            Declaration::REGIMES[$regime]['expiry'],
            Declaration::source($regime),
        ));
    }

    $answers = [];
    $record = [];
    $skipped = 0;
    foreach ($areas as $index => $area) {
        // Per area, because the total says how long it took and this says
        // where it got hard. Hesitation is the measurement the session is
        // actually after, and asking somebody to time themselves with a
        // stopwatch while they think is how you stop them thinking.
        $areaStartedAt = microtime(true);
        printf("\n  ———\n  %s\n\n", Lang::t('declare.area', $index + 1, \count($areas), $area['files']));
        printf("  %s\n", wordwrap(Lang::t(Interview::subject($area['algorithms'])), 76, "\n  "));
        // Several places under one description: name the places. One place:
        // name the files in it.
        printf("  %s\n", Lang::t('declare.area.where', match (true) {
            \count($area['paths']) > 1 => implode(', ', $area['paths']),
            $area['files'] === 1 => $area['names'][0],
            default => implode(', ', array_map(basename(...), $area['names'])).($area['files'] > \count($area['names']) ? ' …' : ''),
        }));

        $name = $ask(Lang::t($first ? 'declare.q.name.first' : 'declare.q.name'), true, $first);
        if ($name === null) {
            ++$skipped;
            $record[] = ['area' => Interview::where($area['paths']), 'places' => $area['paths'], 'skipped' => true, 'seconds' => round(microtime(true) - $areaStartedAt, 1)];
            printf("  %s\n", Lang::t('declare.skipped'));
            continue;
        }

        $retention = $years(Lang::t('declare.q.retention'), $first);
        $damage = $years(Lang::t('declare.q.damage'), $first);
        if ($retention === null && $damage === null) {
            ++$skipped;
            $record[] = ['area' => Interview::where($area['paths']), 'places' => $area['paths'], 'name' => $name, 'skipped' => true, 'seconds' => round(microtime(true) - $areaStartedAt, 1)];
            printf("  %s\n", Lang::t('declare.skipped'));
            continue;
        }

        $lifetime = Interview::lifetime($retention ?? 0, $damage ?? 0);
        $why = match (true) {
            $lifetime === 0 => Lang::t('declare.derived.why.zero'),
            $lifetime === ($damage ?? 0) && $lifetime > ($retention ?? 0) => Lang::t('declare.derived.why.damage'),
            default => Lang::t('declare.derived.why.retention'),
        };
        printf("\n  %s\n", Lang::t('declare.derived', $lifetime, $why));

        $answers[] = [
            'name' => $name,
            'paths' => $area['patterns'],
            'lifetime' => $lifetime,
            'note' => $ask(Lang::t('declare.q.note'), true, $first) ?? '',
        ];

        $first = false;
        $seconds = round(microtime(true) - $areaStartedAt, 1);
        $record[] = [
            'area' => Interview::where($area['paths']),
            'places' => $area['paths'],
            'name' => $name,
            'retention_years' => $retention,
            'harm_years' => $damage,
            'lifetime_years' => $lifetime,
            'skipped' => false,
            'seconds' => $seconds,
        ];
    }

    if ($answers !== [] || $project !== []) {
        /** @var array<string, mixed> $existing */
        $existing = is_file($out) ? Value::map(json_decode((string) file_get_contents($out), true)) : [];
        $merged = Interview::merge([...$existing, ...$project], $answers);
        file_put_contents($out, json_encode($merged, \JSON_PRETTY_PRINT | \JSON_UNESCAPED_SLASHES | \JSON_UNESCAPED_UNICODE)."\n");
        printf("\n  %s\n", Lang::t('declare.written', \count($answers), basename($out)));
    }

    $elapsed = microtime(true) - $startedAt;

    // The sheet in docs/declaration-session.md asks for two of these by hand.
    // Filling them here is not a convenience: a number transcribed after the
    // fact is a number somebody rounded towards the result they hoped for.
    printf("\n  %s\n", Lang::t('declare.times'));
    foreach ($record as $entry) {
        printf(
            "    %s %s%s\n",
            mb_str_pad(\sprintf('%5.1f s', $entry['seconds']), 10),
            mb_str_pad((string) $entry['area'], 34),
            $entry['skipped'] ? ' — '.Lang::t('declare.times.skipped') : '',
        );
    }

    printf("\n  %s\n", Lang::t('declare.elapsed',
        $elapsed < 60 ? \sprintf('%d s', (int) $elapsed) : \sprintf('%d min %02d s', (int) ($elapsed / 60), (int) $elapsed % 60),
        \count($answers),
        $skipped,
    ));

    if ($log !== null) {
        file_put_contents($log, json_encode([
            'project' => basename($root),
            'started_at' => (new \DateTimeImmutable())->format(\DateTimeInterface::ATOM),
            'seconds' => round($elapsed, 1),
            'answered' => \count($answers),
            'skipped' => $skipped,
            'areas' => $record,
        ], \JSON_PRETTY_PRINT | \JSON_UNESCAPED_SLASHES | \JSON_UNESCAPED_UNICODE)."\n");
        printf("  → %s\n", $log);
    }

    echo "\n";
    exit(0);
}

// --- collect published vulnerabilities: bin/sablier advisories <path> ---
// The one command in this tool that is allowed to reach the network, and it
// reaches it for a database rather than with your inventory: the scanner runs
// in a container, reads the lock files from a read-only mount, and writes a
// file you can read. A scan never does any of that.
if ($command === 'advisories') {
    // Reaches a vulnerability database, in a container. Both are the network.
    if (Airgap::on()) {
        Airgap::refuse('advisories');
    }

    $target = $argv[2] ?? '';
    $out = '.sablier/advisories.json';
    foreach (\array_slice($argv, 3) as $argument) {
        if (preg_match('/^--out=(.+)$/', $argument, $m) === 1) {
            $out = $m[1];
        }
    }

    $root = $target !== '' ? realpath($target) : false;
    if ($root === false || !is_dir($root)) {
        fwrite(\STDERR, '✗ '.Lang::t('cli.missing_path')."\n");
        exit(1);
    }

    $docker = Docker::binary();
    if ($docker === null) {
        fwrite(\STDERR, '✗ '.Lang::t('advisories.no_docker')."\n");
        exit(1);
    }

    // Pinned by digest for the same reason as in the Makefile: a tag is a name
    // and a name can be re-pointed, and `make cve` proves something about bytes.
    // Override it with SABLIER_TRIVY_IMAGE when your site mirrors its own.
    $scanner = getenv('SABLIER_TRIVY_IMAGE')
        ?: 'aquasec/trivy:0.76.2@sha256:8f6bb947dbc528902e11f2f5be52f7b519f6a39d5d148f41166f2040499768fb';
    $cache = (getenv('HOME') ?: sys_get_temp_dir()).'/.cache/trivy';
    @mkdir($cache, 0o755, true);
    printf("\n  %s\n", Lang::t('advisories.running', $scanner));

    $raw = (string) @shell_exec(\sprintf(
        '%s run --rm --volume %s:/root/.cache --volume %s:/project:ro %s fs --scanners vuln --format json --quiet /project 2>/dev/null',
        escapeshellarg($docker),
        escapeshellarg($cache),
        escapeshellarg($root),
        escapeshellarg($scanner),
    ));

    $report = Value::map(json_decode($raw, true));
    if ($report === []) {
        fwrite(\STDERR, '✗ '.Lang::t('advisories.failed', $scanner)."\n");
        exit(1);
    }

    $collected = Advisories::fromScannerReport($report, $scanner, $root);
    // dirname() always answers something, "." included; only a directory that
    // is not there yet needs creating.
    $directory = \dirname($out);
    if (!is_dir($directory)) {
        @mkdir($directory, 0o755, true);
    }
    file_put_contents($out, json_encode($collected, \JSON_PRETTY_PRINT | \JSON_UNESCAPED_SLASHES | \JSON_UNESCAPED_UNICODE)."\n");

    $packages = Value::map($collected['packages'] ?? null);
    printf("  %s\n", Lang::t('advisories.written', $out, \count($packages), Value::int($collected['other_vulnerable_packages'] ?? null)));
    printf("  %s\n\n", Lang::t('advisories.next', $out));
    exit(0);
}

// --- probe only: bin/sablier probe example.org --------------------------
if ($command === 'probe') {
    if (Airgap::on()) {
        Airgap::refuse('probe');
    }

    $target = $argv[2] ?? null;
    if ($target === null) {
        fwrite(\STDERR, '✗ '.Lang::t('cli.missing_host')."\n");
        exit(1);
    }
    // mx://example.org stands for every server receiving its mail.
    foreach (Probe::expand($target) as $host) {
        $result = (new Probe())->run($host);
        printf("\n  %s\n\n", sablier_probe_heading($target, $host));
        foreach ($result['facts'] as $key => $value) {
            // mb_str_pad: printf counts bytes, so accents would shift the column.
            printf("    %s %s\n", mb_str_pad((string) $key, 28), $value);
        }
        foreach ($result['notes'] as $note) {
            printf("\n    ⚠ %s\n", wordwrap($note, 88, "\n      "));
        }
        foreach ($result['findings'] as $finding) {
            printf("\n    · %s — %s\n", Catalogue::label($finding->algorithm), $finding->detail);
        }
    }
    echo "\n";
    exit(0);
}

// Past this point, two commands share one body: `scan` builds the inventory by
// reading a project, `judge` reads one somebody else's tool produced. Everything
// after the inventory — the risk model, the report, the baseline, the exit code
// — is the same, and that is the whole argument for the import.
if (!\in_array($command, ['scan', 'judge'], true)) {
    fwrite(\STDOUT, Lang::t('cli.usage')."\n");
    exit($command === 'help' ? 0 : 1);
}

$target = null;
$options = ['declare' => null, 'out' => null, 'json' => null, 'cbom' => null, 'audit' => null, 'incident' => null, 'calendar' => null, 'pdf' => null, 'year' => null, 'sign' => null, 'timestamp' => [], 'anchor' => [], 'baseline' => null, 'advisories' => null, 'quiet' => false, 'no-probe' => false, 'breached' => null];
foreach (\array_slice($argv, 2) as $arg) {
    if ($arg === '--quiet' || $arg === '--no-probe') {
        $options[substr($arg, 2)] = true;
    } elseif (preg_match('/^--(declare|out|json|cbom|audit|incident|calendar|pdf|year|sign|timestamp|anchor|baseline|advisories|breached)=(.+)$/', $arg, $m) === 1) {
        // One authority is one point of trust. The flag therefore accumulates
        // instead of overwriting, and accepts a comma-separated list in one go,
        // so corroborating a date across jurisdictions costs an argument rather
        // than a second run — and a second run would be worse than nothing: it
        // would re-sign the same findings and overwrite the first token.
        // --anchor accumulates the same way, for the same reason.
        if ($m[1] === 'timestamp' || $m[1] === 'anchor') {
            foreach (explode(',', $m[2]) as $url) {
                $url = trim($url);
                if ($url !== '' && !\in_array($url, $options[$m[1]], true)) {
                    $options[$m[1]][] = $url;
                }
            }
        } else {
            $options[$m[1]] = $m[2];
        }
    } elseif (!str_starts_with($arg, '--')) {
        $target = $arg;
    }
}

// Where the HTML goes, and whether it goes anywhere at all. Run by hand without
// --out, you want a report, so there is a default. Run with --quiet, you want
// the verdict in the exit code — that is the pipeline's usage, and dropping an
// unrequested page into somebody's repository is leaving state behind. It is
// still written when something downstream needs it: the PDF is rendered from
// it, and the signature is filed beside it.
$reportPath = $options['out'];
if ($reportPath === null && (!$options['quiet'] || $options['pdf'] !== null || $options['sign'] !== null)) {
    $reportPath = 'report.html';
}

if ($target === null || ($command === 'scan' ? !is_dir($target) : !is_file($target))) {
    fwrite(\STDERR, '✗ '.Lang::t($command === 'scan' ? 'cli.missing_path' : 'cli.missing_cbom')."\n");
    exit(1);
}

// A scanned project carries its declaration; an imported CBOM has none of its
// own, so the declaration is the one in the hand that runs the command.
$declarationPath = $options['declare'] ?? match (true) {
    $command === 'scan' && is_file($target.'/sablier.json') => $target.'/sablier.json',
    $command === 'judge' && is_file('sablier.json') => 'sablier.json',
    default => null,
};
$declaration = Declaration::load($declarationPath);
// A date on the command line is the worst case: every declared domain is
// treated as breached. Putting it in the declaration instead names the domains
// that actually lost data, which is the version somebody reviews.
if ($options['breached'] !== null) {
    $declaration->breachedOn = $options['breached'];
    foreach ($declaration->domains as $index => $domain) {
        $declaration->domains[$index]['breached'] = $options['breached'];
    }
}
// --year projects the same codebase into a future year. The expiry date does
// not move — it is a regulatory deadline — but the other side of the comparison
// does: every year that passes pushes more data over the line. Worth being able
// to show, and worth marking loudly so a projection is never read as a finding.
$actualYear = (int) date('Y');
$currentYear = $options['year'] !== null ? (int) $options['year'] : $actualYear;

$startedAt = microtime(true);

$probes = [];
$importedFrom = '';
// An imported inventory was not searched for by this tool, so the box that says
// what it looked for and did not find stays empty rather than borrowing credit
// for somebody else's scan.
$searched = [];
if ($command === 'scan') {
    // Composition happens here and nowhere else: the scanner receives what it
    // must run, instead of knowing the list itself.
    $scan = sablier_scanner($declaration)->scan($target);

    // Live probes come from the declaration: what a server negotiates belongs
    // to the same inventory as what the code says, and it is the only part a
    // file can contradict.
    $probeFindings = [];
    // Declared hosts on a closed site: skipped rather than refused, because an
    // audit stopped by its own flag helps nobody — and said out loud in the
    // blind spots, which is what that section is for.
    $airgapSkippedProbe = Airgap::on() && $declaration->probe !== [];
    if (!$options['no-probe'] && !Airgap::on()) {
        foreach ($declaration->probe as $declared) {
            foreach (Probe::expand($declared) as $host) {
                $result = (new Probe())->run($host);
                $probes[] = ['target' => sablier_probe_heading($declared, $host), 'facts' => $result['facts'], 'notes' => $result['notes']];
                $probeFindings = [...$probeFindings, ...$result['findings']];
            }
        }
    }

    $inventory = [...$scan['findings'], ...$probeFindings];
    $filesRead = $scan['files'];
    $blind = $scan['blind'];
    $searched = $scan['searched'];
    if (Airgap::on()) {
        $blind[] = $airgapSkippedProbe
            ? Lang::t('airgap.blind.skipped', \count($declaration->probe))
            : Lang::t('airgap.blind.on');
    }
    $label = $target;
} else {
    // Somebody else's inventory. We judge it; we did not detect it, and the
    // report says so rather than borrowing the credit — along with what the
    // import could not understand, which is the part a silent importer hides.
    $imported = Cbom::read($target);
    if ($imported === null) {
        fwrite(\STDERR, '✗ '.Lang::t('cbom.unreadable', $target)."\n");
        exit(1);
    }

    $inventory = $imported['findings'];
    $filesRead = $imported['locations'];
    $label = $imported['project'];
    $importedFrom = $imported['producer'];
    $blind = [Lang::t('cbom.blind.imported', \count($inventory), $imported['producer'])];
    if ($imported['ignored'] !== []) {
        $names = array_slice(array_values(array_unique($imported['ignored'])), 0, 8);
        $blind[] = Lang::t('cbom.blind.ignored', \count($imported['ignored']), implode(', ', $names));
    }
    if ($imported['unplaced'] > 0) {
        $blind[] = Lang::t('cbom.blind.no_location', $imported['unplaced']);
    }
}

// Published vulnerabilities are read from a file the operator collected on
// purpose. Absent, the report says the question was not asked rather than
// implying the answer was no.
$advisories = null;
if ($options['advisories'] !== null) {
    $advisories = Advisories::load($options['advisories']);
    if ($advisories === null) {
        fwrite(\STDERR, '✗ '.Lang::t('advisories.unreadable', $options['advisories'])."\n");
        exit(1);
    }
}

$findings = (new Assessor($declaration, $currentYear, $advisories))->assess($inventory);
$duration = microtime(true) - $startedAt;

// Said after the assessment, because whether it is worth saying depends on it.
//
// A published vulnerability can only change a verdict on a library this tool
// catalogued — that is the one place where "presence is not usage" gives way.
// A project with no such library has nothing for the advisory collection to
// touch, and telling its reader that a hole might be hiding in dependencies
// that do not exist is an alarm with no subject. Measured on three projects
// before changing it: this tool itself has no dependencies at all, the blog has
// three and none of them is cryptographic, and the application has seven — only
// the third needs the sentence.
//
// What replaces it in the other two is already printed, in the other box: the
// dependency files were read, and no catalogued library was in them.
$catalogued = 0;
foreach ($findings as $finding) {
    if ($finding->inventory) {
        ++$catalogued;
    }
}

if ($advisories !== null) {
    $blind[] = Lang::t('advisories.blind.used', $advisories->scanner, substr($advisories->generatedAt, 0, 10), $advisories->count(), $advisories->ignored);
} elseif ($catalogued > 0) {
    $blind[] = Lang::t('advisories.blind.absent');
}

// Signing happens after the analysis and over the findings, never over the
// rendered file: two runs of the same inventory differ byte for byte and say
// exactly the same thing.
// A timestamping authority is on the network, and the airgap switch refuses
// rather than skips. It was added after that switch existed and was not wired
// into it, so on a closed site this flag would have reached for an authority
// that is not supposed to be reachable — found while writing down, line by
// line, everything this tool can send.
if ($options['timestamp'] !== [] && Airgap::on()) {
    Airgap::refuse('--timestamp');
}
// A calendar is on the network too, and was wired in from the start this time.
if ($options['anchor'] !== [] && Airgap::on()) {
    Airgap::refuse('--anchor');
}

// An attestation needs something to attest and a file to sit beside, and both
// come from signing. Refused rather than ignored: a flag that does nothing is
// worse than a flag that says why.
if ($options['timestamp'] !== [] && $options['sign'] === null) {
    fwrite(\STDERR, '✗ '.Lang::t('cli.timestamp_needs_sign')."\n");
    exit(1);
}
if ($options['anchor'] !== [] && $options['sign'] === null) {
    fwrite(\STDERR, '✗ '.Lang::t('cli.anchor_needs_sign')."\n");
    exit(1);
}

$signature = null;
$timestamps = [];
$anchor = null;
$kept = false;
if ($options['sign'] !== null) {
    // --sign gives the run an output path a hundred lines above, so this is
    // never null here. Written as code rather than as a comment: a comment does
    // not survive the next edit, and a static analyser cannot read one.
    $reportPath ??= 'report.html';

    $preliminary = new Analysis($findings, $declaration, $label, $filesRead, $blind, $currentYear);

    // Two ways to hold a signing key, and the second is the one an auditor
    // should want: a pair made for this report, used once, and gone before the
    // command returns. Nothing to store, nothing to steal, nothing to rotate,
    // and a key that can never sign a second document. What proves who signed
    // is then the channel that carries the fingerprint, not a file on a laptop.
    $ephemeral = $options['sign'] === 'ephemeral';
    $fingerprint = '';
    if ($ephemeral) {
        $pair = Signature::keypair();
        $pq = MlDsa::keypair();
        $secret = $pair['secret'];
        $pqSecret = $pq['secret'] ?? '';
        $fingerprint = Signature::fingerprint($pair['public'], $pq['public'] ?? '');
    } else {
        if (!is_file($options['sign'])) {
            fwrite(\STDERR, '✗ '.Lang::t('cli.key_missing', $options['sign'])."\n");
            exit(1);
        }
        $hybridKey = Signature::hybridKeyPath($options['sign']);
        $secret = trim((string) file_get_contents($options['sign']));
        $pqSecret = is_file($hybridKey) ? (string) file_get_contents($hybridKey) : '';
    }

    $digest = Signature::digest($preliminary);

    // A seal that moves when nothing moved is a seal that says nothing.
    //
    // Re-running an unchanged analysis used to produce a new `signed_at`, a new
    // signature over the same digest, and a chain link from a digest to itself.
    // Published daily, that is a document whose date changes every morning while
    // its content does not — and a chain of identical links, which is noise
    // dressed as history. Worse for the attestation below: re-requesting a token
    // destroys the earliest one, and the earliest is the only one that supports
    // "we had inventoried before the deadline".
    //
    // So an existing signature is kept when it covers the same findings and the
    // same key. A different key is a deliberate act — a rotation — and signs
    // again; an ephemeral run always signs, since its key exists for one
    // document and cannot be the one in the file.
    $existing = is_file($reportPath.'.sig')
        ? Value::map(json_decode((string) file_get_contents($reportPath.'.sig'), true))
        : [];
    // Only to compare with what the existing file claims: a secret that does not
    // decode is a problem for Signature::sign() to report, not a reason to crash
    // here, so it simply fails the comparison and the run signs again.
    $raw = $ephemeral ? false : base64_decode($secret, true);
    $publicKey = \is_string($raw) && \strlen($raw) === \SODIUM_CRYPTO_SIGN_SECRETKEYBYTES
        ? base64_encode(sodium_crypto_sign_publickey_from_secretkey($raw))
        : '';
    $unchanged = !$ephemeral
        && $publicKey !== ''
        && Value::string($existing['digest'] ?? null) === $digest
        && Value::string($existing['public_key'] ?? null) === $publicKey;

    if ($unchanged) {
        /** @var array{algorithm:string, digest:string, signed_at:string, public_key:string, signature:string} $signature */
        $signature = $existing;
        $kept = true;
    } else {
        $signature = Signature::sign(
            $digest,
            $secret,
            // Whatever was signed at this path before. No flag: a second run
            // over the same output succeeds the first, and a chain nobody has
            // to ask for is a chain that exists.
            Signature::previousDigest($reportPath.'.sig'),
            $pqSecret,
        );
        $kept = false;
    }

    // The private halves leave with the command that made them — once the
    // pages are written and signed too, at the end of the run.
    if ($ephemeral) {
        $signature['ephemeral'] = true;
    }
    if (!$kept) {
        file_put_contents($reportPath.'.sig', json_encode($signature, \JSON_PRETTY_PRINT | \JSON_UNESCAPED_SLASHES)."\n");
    }

    // A date somebody else attests. Our own `signed_at` is covered by the
    // signature, so it cannot be edited afterwards — but it is read off our own
    // clock, so backdating a report costs nothing. The token answers the one
    // question our seals do not.
    //
    // A failure here does not fail the scan: the verdicts are about somebody's
    // cryptography, not about whether a network reached an authority. What it
    // must never do is pass quietly — a document that lacks the guarantee the
    // operator asked for, with nothing said, is the exact shape of false
    // assurance this tool spends its pages refusing. So it is loud on stderr and
    // no `.tsr` is written, which means the report claims nothing about a date.
    // One slot per authority, in the order they were named. A slot is stable
    // across runs: an authority that was unreachable today leaves its slot empty
    // rather than shifting the others down, which is what keeps each
    // attestation's antecedence attached to the authority that made it.
    $timestamps = sablier_attest_tokens($reportPath, $digest, $options['timestamp']);

    // The same date, anchored where nobody has to be believed about it. Same
    // digest, same rules as the tokens above: loud but not fatal when no
    // calendar answers, and the oldest anchoring kept — an existing proof of
    // this digest is completed in place, never replaced by a newer one.
    if ($options['anchor'] !== []) {
        $anchor = sablier_attest_anchor($reportPath, $digest, $options['anchor']);
    }
}

$cwd = getcwd();
$analysis = new Analysis(
    findings: $findings,
    declaration: $declaration,
    target: $label,
    filesRead: $filesRead,
    blindSpots: $blind,
    currentYear: $currentYear,
    duration: $duration,
    probes: $probes,
    projected: $currentYear !== $actualYear,
    signature: $signature,
    timestamps: $timestamps,
    anchor: $anchor,
    importedFrom: $importedFrom,
    // Printed in the audit report: a document that cannot be reproduced is an
    // assertion, not a finding. The binary is named relative to where it was
    // run from — an absolute path says more about the machine that produced the
    // document than about the command a reader is meant to repeat.
    searched: $searched,
    reportPath: $reportPath ?? '',
    auditPath: $options['audit'] ?? '',
    // The report links to its PDF before the PDF exists: the PDF is typeset
    // from the report. The one thing that stops it being made is a PHP without
    // DOM, known now, so the link is never written to a file that will not come.
    pdfLink: $options['pdf'] !== null && $reportPath !== null && class_exists(\DOMDocument::class)
        ? sablier_link_below($reportPath, $options['pdf'])
        : '',
    commandLine: implode(' ', array_map(
        static function (string $argument) use ($cwd): string {
            if ($cwd !== false && str_starts_with($argument, $cwd.'/')) {
                $argument = './'.substr($argument, \strlen($cwd) + 1);
            }

            return str_contains($argument, ' ') ? '"'.$argument.'"' : $argument;
        },
        $argv,
    )),
);

if ($reportPath !== null) {
    file_put_contents($reportPath, (new HtmlReporter())->render($analysis));
}

if ($options['json'] !== null) {
    file_put_contents($options['json'], (new JsonReporter())->render($analysis));
}

// The inventory in the format other tools read. The house JSON stays for our
// own baseline; this one is for everybody else's pipeline.
if ($options['cbom'] !== null) {
    file_put_contents($options['cbom'], (new CbomReporter())->render($analysis)."\n");
}

// The same analysis, written for whoever has to weigh it rather than act on
// it. A second document rather than a mode of the first: they are read by
// different people, in different rooms.
if ($options['audit'] !== null) {
    file_put_contents($options['audit'], (new AuditReporter())->render($analysis));
}

// The third document: the week after, for the room where somebody has to say
// how long this keeps costing. It is built on a date the organisation gives,
// and it refuses rather than invent one — a post-breach document produced by a
// tool that decided on its own that there was a breach is worse than none.
if ($options['incident'] !== null) {
    if (Breach::lines($analysis) === []) {
        fwrite(\STDERR, '✗ '.Lang::t('cli.incident_none')."\n");
        exit(1);
    }
    file_put_contents($options['incident'], (new IncidentReporter())->render($analysis));
}

// The crossings as appointments. A date in a report is read once; a date in a
// calendar interrupts somebody in 2029, which is the only version that works.
if ($options['calendar'] !== null) {
    file_put_contents($options['calendar'], Crossings::toIcalendar($analysis));
}

$pdfMessage = null;
$auditPdfMessage = null;
if ($options['pdf'] !== null && $reportPath !== null) {
    [, $pdfMessage] = Pdf::render($reportPath, $options['pdf']);
    // The audit document is the one that gets printed, signed and filed, so
    // asking for a PDF asks for both. Its name is the audit file's, which is
    // predictable enough not to need an option of its own.
    if ($options['audit'] !== null) {
        $auditPdf = preg_replace('/\.html?$/i', '', $options['audit']).'.pdf';
        [, $auditPdfMessage] = Pdf::render($options['audit'], $auditPdf);
    }
    // Same rule for the post-breach document, which is the one of the three
    // most likely to be printed and carried into a meeting.
    if ($options['incident'] !== null) {
        Pdf::render($options['incident'], preg_replace('/\.html?$/i', '', $options['incident']).'.pdf');
    }
}

// Every page, signed as the file it is, once it is on disk in its final form.
// The findings signature above cannot cover a page that displays it; a
// signature filed beside the page can, so a single character changed in a
// published report no longer verifies.
$pageSignatures = [];
if ($signature !== null) {
    $pages = [$reportPath, $options['audit'], $options['incident']];
    if ($options['pdf'] !== null) {
        $pages[] = $options['pdf'];
        if ($options['audit'] !== null) {
            $pages[] = preg_replace('/\.html?$/i', '', $options['audit']).'.pdf';
        }
        if ($options['incident'] !== null) {
            $pages[] = preg_replace('/\.html?$/i', '', $options['incident']).'.pdf';
        }
    }
    foreach ($pages as $page) {
        if (\is_string($page) && is_file($page)) {
            $pageSignatures[] = sablier_sign_page($page, $digest, $secret, $pqSecret, $ephemeral);
        }
    }

    sodium_memzero($secret);
    if ($pqSecret !== '') {
        sodium_memzero($pqSecret);
    }
}

$counts = [];
foreach ($findings as $finding) {
    $counts[$finding->verdict] = ($counts[$finding->verdict] ?? 0) + 1;
}

// --- what changed since the reference run --------------------------------
// The exit code is decided here, before anything is printed, because --quiet
// exists for pipelines: a step that stays silent must still be able to stop
// the build.
$diff = null;
if ($options['baseline'] !== null) {
    $baseline = Baseline::load($options['baseline']);
    if ($baseline === null) {
        fwrite(\STDERR, '✗ '.Lang::t('diff.missing', $options['baseline'], $options['baseline'])."\n");
        exit(1);
    }
    $diff = $baseline->compare($findings);
}

$status = $diff !== null
    ? ($diff['decisions'] > 0 ? 2 : 0)
    : (($counts[Assessor::COMPROMISED] ?? 0) > 0 ? 2 : 0);

// Columns are padded to the widest entry of this run rather than to a fixed
// guess: verdict labels differ by language, and a ragged list of findings is
// read as a dump instead of a table.
$verdictText = static fn (Finding $finding, string $from): string => ($from === '' ? '' : Assessor::label($from).' → ').Assessor::label($finding->verdict);
$width = ['verdict' => 0, 'algorithm' => 0];
if ($diff !== null) {
    $entries = [...array_map(static fn (Finding $f): array => [$f, ''], $diff['new']),
        ...array_map(static fn (array $c): array => [$c['finding'], $c['from']], $diff['worsened']),
        ...array_map(static fn (Finding $f): array => [$f, ''], $diff['red'])];
    foreach ($entries as [$finding, $from]) {
        $width['verdict'] = max($width['verdict'], mb_strlen($verdictText($finding, $from)));
        $width['algorithm'] = max($width['algorithm'], mb_strlen($finding->algorithm));
    }
}

/** One line per finding: its fingerprint first, because that is what you type next. */
$line = static function (Finding $finding, string $from = '') use ($verdictText, $width): string {
    return \sprintf(
        "        %s  %s  %s  %s\n",
        $finding->fingerprint(),
        mb_str_pad($verdictText($finding, $from), $width['verdict']),
        mb_str_pad($finding->algorithm, $width['algorithm']),
        $finding->file.($finding->line > 0 ? ':'.$finding->line : ''),
    );
};

$verdictLine = static function (?array $diff): void {
    if ($diff === null) {
        return;
    }
    echo $diff['decisions'] > 0
        ? \sprintf("  ✗ %s\n     %s\n\n", Lang::t('diff.stop', Value::int($diff['decisions'])), Lang::t('diff.how'))
        : \sprintf("  ✓ %s\n\n", Lang::t('diff.go'));
};

if ($options['quiet']) {
    if ($pdfMessage !== null) {
        printf("  %s\n", $pdfMessage);
    }
    $verdictLine($diff);
    exit($status);
}

$sourceLabel = $importedFrom !== ''
    ? Lang::t('report.imported_from', $importedFrom, $filesRead)
    : Lang::t('report.files_read', $filesRead);
printf("\n  %s — %s, %s, %.1f s\n", $label, $sourceLabel, Lang::t('cli.findings', \count($findings)), $duration);
// The colon belongs to the label: French puts a space before it, English does not.
printf("  %s %s\n\n", Lang::t('cli.declaration'), $declarationPath ?? Lang::t('cli.no_declaration'));
foreach (Assessor::order() as $verdict) {
    if (isset($counts[$verdict])) {
        printf("    %s %d\n", mb_str_pad(Assessor::label($verdict), 24), $counts[$verdict]);
    }
}
echo "\n";
if ($reportPath !== null) {
    printf("  → %s\n", $reportPath);
}
if ($options['cbom'] !== null) {
    printf("  → %s\n", $options['cbom']);
}
if ($options['audit'] !== null) {
    printf("  → %s\n", $options['audit']);
}
if ($options['calendar'] !== null) {
    printf("  → %s\n", $options['calendar']);
}
if ($auditPdfMessage !== null) {
    printf("  → %s\n", $auditPdfMessage);
}
if ($pdfMessage !== null) {
    printf("  → %s\n", $pdfMessage);
}
foreach ($timestamps as $timestamp) {
    printf("  → %s\n", Lang::t('cli.timestamped', $timestamp['path'], Timestamp::readable($timestamp['time']), $timestamp['authority']));
}
if ($anchor !== null) {
    printf("  → %s\n", match ($anchor['state']) {
        'anchored' => Lang::t('cli.anchored', $anchor['path'], $anchor['height'], OpenTimestamps::readable($anchor['time'])),
        'pending' => Lang::t('cli.anchor.pending', $anchor['path'], implode(', ', $anchor['calendars'])),
        'invalid' => Lang::t('cli.anchor.invalid', $anchor['path'], $anchor['height']),
        'none' => Lang::t('cli.anchor.none', $anchor['path']),
        default => Lang::t('cli.anchor.claimed', $anchor['path'], $anchor['height']),
    });
}
if ($signature !== null) {
    printf("  → %s\n", Lang::t($kept ? 'cli.signed.kept' : 'cli.signed', $reportPath.'.sig'));
    foreach ($pageSignatures as $pageSignature) {
        printf("  → %s\n", $pageSignature);
    }
    if ($fingerprint !== '') {
        printf("\n  %s\n\n    %s\n\n  %s\n", Lang::t('seal.ephemeral.done'), $fingerprint, Lang::t('seal.ephemeral.send'));
    }
}
echo "\n";

if ($diff !== null) {
    // The reference names itself: reading the path back out of the options bag
    // asks every reader, human or machine, to prove it is still a string.
    printf("  %s\n", Lang::t('diff.header', $baseline->path, $baseline->count()));
    if ($diff['new'] !== [] || $diff['worsened'] !== [] || $diff['red'] !== [] || $diff['resolved'] !== []) {
        echo "\n";
    }
    if ($diff['new'] !== []) {
        printf("    + %s\n", Lang::t('diff.new', \count($diff['new'])));
        foreach ($diff['new'] as $finding) {
            echo $line($finding);
        }
    }
    if ($diff['worsened'] !== []) {
        printf("    ↑ %s\n", Lang::t('diff.worse', \count($diff['worsened'])));
        foreach ($diff['worsened'] as $change) {
            echo $line($change['finding'], $change['from']);
        }
    }
    if ($diff['red'] !== []) {
        printf("    ● %s\n", Lang::t('diff.red', \count($diff['red'])));
        foreach ($diff['red'] as $finding) {
            echo $line($finding);
        }
    }
    if ($diff['resolved'] !== []) {
        printf("    − %s\n", Lang::t('diff.gone', \count($diff['resolved'])));
    }
    echo "\n";
}

$verdictLine($diff);

// Non-zero exit when a decision is due: a new finding, a verdict that got
// worse, a red finding nobody has decided on — or, with no reference to
// compare against, long-lived data already exposed. That is what makes this
// usable as a pipeline step.
exit($status);
