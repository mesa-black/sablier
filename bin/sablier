#!/usr/bin/env php
<?php

declare(strict_types=1);

/*
 * Sablier — cryptographic inventory, and the expiry date of each protection.
 *
 *   bin/sablier scan <path> [--declare=sablier.json] [--out=report.html] [--pdf=report.pdf]
 *   bin/sablier probe <host>
 *
 * No dependency, no network call of its own, no telemetry. On a tool that reads
 * where the keys are, that is not a posture: every dependency would be one more
 * supply chain to defend.
 */

namespace Sablier;

foreach (['Lang', 'Catalogue', 'Declaration', 'Finding', 'Scanner', 'Assessor', 'Probe', 'Pdf', 'Report'] as $class) {
    require __DIR__.'/../src/'.$class.'.php';
}

$argv = $_SERVER['argv'];
$command = $argv[1] ?? 'help';

// Language is read before anything else: the help text is translated too.
Lang::use(getenv('SABLIER_LANG') ?: 'fr');
foreach ($argv as $arg) {
    if (preg_match('/^--lang=(\w+)$/', $arg, $m) === 1) {
        Lang::use($m[1]);
    }
}

// --- probe only: bin/sablier probe example.org --------------------------
if ($command === 'probe') {
    $target = $argv[2] ?? null;
    if ($target === null) {
        fwrite(\STDERR, '✗ '.Lang::t('cli.missing_host')."\n");
        exit(1);
    }
    $result = (new Probe())->run($target);
    printf("\n  %s\n\n", $target);
    foreach ($result['facts'] as $key => $value) {
        // mb_str_pad: printf counts bytes, so accents would shift the column.
        printf("    %s %s\n", mb_str_pad((string) $key, 28), $value);
    }
    foreach ($result['notes'] as $note) {
        printf("\n    ⚠ %s\n", wordwrap($note, 88, "\n      "));
    }
    foreach ($result['findings'] as $finding) {
        printf("\n    · %s — %s\n", Catalogue::label($finding->algorithm), $finding->detail);
    }
    echo "\n";
    exit(0);
}

if ($command !== 'scan') {
    fwrite(\STDOUT, Lang::t('cli.usage')."\n");
    exit($command === 'help' ? 0 : 1);
}

$target = null;
$options = ['declare' => null, 'out' => 'report.html', 'json' => null, 'pdf' => null, 'quiet' => false, 'no-probe' => false];
foreach (\array_slice($argv, 2) as $arg) {
    if ($arg === '--quiet' || $arg === '--no-probe') {
        $options[substr($arg, 2)] = true;
    } elseif (preg_match('/^--(declare|out|json|pdf)=(.+)$/', $arg, $m) === 1) {
        $options[$m[1]] = $m[2];
    } elseif (!str_starts_with($arg, '--')) {
        $target = $arg;
    }
}

if ($target === null || !is_dir($target)) {
    fwrite(\STDERR, '✗ '.Lang::t('cli.missing_path')."\n");
    exit(1);
}

$declarationPath = $options['declare'] ?? (is_file($target.'/sablier.json') ? $target.'/sablier.json' : null);
$declaration = Declaration::load($declarationPath);
$currentYear = (int) date('Y');

$startedAt = microtime(true);
$scan = (new Scanner())->scan($target);

// Live probes come from the declaration: what a server negotiates belongs to
// the same inventory as what the code says, and it is the only part a file can
// contradict.
$probes = [];
$probeFindings = [];
if (!$options['no-probe']) {
    foreach ($declaration->probe as $host) {
        $result = (new Probe())->run($host);
        $probes[] = ['target' => $host, 'facts' => $result['facts'], 'notes' => $result['notes']];
        $probeFindings = [...$probeFindings, ...$result['findings']];
    }
}

$findings = (new Assessor($declaration, $currentYear))->assess([...$scan['findings'], ...$probeFindings]);
$duration = microtime(true) - $startedAt;

$report = new Report($findings, $declaration, $target, $scan['files'], $scan['blind'], $currentYear, $duration, $probes);
file_put_contents($options['out'], $report->html());

if ($options['json'] !== null) {
    file_put_contents($options['json'], json_encode(array_map(static fn (Finding $f): array => [
        'algorithm' => $f->algorithm, 'purpose' => $f->purpose, 'file' => $f->file, 'line' => $f->line,
        'domain' => $f->domain, 'declared' => $f->domainDeclared, 'lifetime_years' => $f->lifetime,
        'verdict' => $f->verdict, 'confidence' => $f->confidence, 'because' => $f->because,
    ], $findings), \JSON_PRETTY_PRINT | \JSON_UNESCAPED_UNICODE | \JSON_UNESCAPED_SLASHES));
}

$pdfMessage = null;
if ($options['pdf'] !== null) {
    [, $pdfMessage] = Pdf::render($options['out'], $options['pdf']);
}

if ($options['quiet']) {
    if ($pdfMessage !== null) {
        printf("  %s\n", $pdfMessage);
    }
    exit(0);
}

$counts = [];
foreach ($findings as $finding) {
    $counts[$finding->verdict] = ($counts[$finding->verdict] ?? 0) + 1;
}

printf("\n  %s — %s, %s, %.1f s\n", $target, Lang::t('report.files_read', $scan['files']), Lang::t('cli.findings', \count($findings)), $duration);
printf("  %s : %s\n\n", Lang::t('cli.declaration'), $declarationPath ?? Lang::t('cli.no_declaration'));
foreach (Assessor::order() as $verdict) {
    if (isset($counts[$verdict])) {
        printf("    %s %d\n", mb_str_pad(Assessor::label($verdict), 24), $counts[$verdict]);
    }
}
printf("\n  → %s\n", $options['out']);
if ($pdfMessage !== null) {
    printf("  → %s\n", $pdfMessage);
}
echo "\n";

// Non-zero exit when long-lived data is already exposed: that is what makes
// this usable as a pipeline step.
exit(($counts[Assessor::COMPROMISED] ?? 0) > 0 ? 2 : 0);
