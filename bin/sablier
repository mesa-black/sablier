#!/usr/bin/env php
<?php

declare(strict_types=1);

/*
 * Sablier — cryptographic inventory, and the expiry date of each protection.
 *
 *   bin/sablier scan <path> [--declare=sablier.json] [--out=report.html] [--pdf=report.pdf]
 *   bin/sablier probe <host>
 *
 * No dependency, no network call of its own, no telemetry. On a tool that reads
 * where the keys are, that is not a posture: every dependency would be one more
 * supply chain to defend.
 */

namespace Sablier;

// A four-line autoloader rather than a require list that has to be kept in
// order: adding a detector must not mean editing this file.
spl_autoload_register(static function (string $class): void {
    if (str_starts_with($class, 'Sablier\\')) {
        $path = __DIR__.'/../src/'.str_replace('\\', '/', substr($class, 8)).'.php';
        if (is_file($path)) {
            require $path;
        }
    }
});

use Sablier\Detector\DependencyDetector;
use Sablier\Detector\EnvDetector;
use Sablier\Detector\FrameworkConfigDetector;
use Sablier\Detector\KeyMaterialDetector;
use Sablier\Detector\PhpDetector;
use Sablier\Detector\ServerConfigDetector;
use Sablier\Detector\ShellDetector;
use Sablier\Detector\SshConfigDetector;
use Sablier\Detector\SymfonyVaultDetector;
use Sablier\Reporter\AuditReporter;
use Sablier\Reporter\CbomReporter;
use Sablier\Reporter\HtmlReporter;
use Sablier\Reporter\JsonReporter;

// Arguments are read through the same door as every other outside value: a
// list of strings, whatever the runtime put in $_SERVER.
/** @var list<string> $argv */
$argv = array_values(array_map(
    static fn (mixed $argument): string => Value::string($argument),
    Value::map($_SERVER['argv'] ?? null),
));
$command = $argv[1] ?? 'help';

// Language is read before anything else: the help text is translated too.
Lang::use(getenv('SABLIER_LANG') ?: 'fr');
foreach ($argv as $arg) {
    if (preg_match('/^--lang=(\w+)$/', $arg, $m) === 1) {
        Lang::use($m[1]);
    }
}

// --- keys and verification ---------------------------------------------
if ($command === 'keygen') {
    $out = 'sablier.key';
    foreach (\array_slice($argv, 2) as $arg) {
        if (preg_match('/^--out=(.+)$/', $arg, $m) === 1) {
            $out = $m[1];
        }
    }
    if (is_file($out)) {
        fwrite(\STDERR, '✗ '.Lang::t('cli.key_exists', $out)."\n");
        exit(1);
    }

    $pair = Signature::keypair();
    file_put_contents($out, $pair['secret']."\n");
    chmod($out, 0600);

    printf("  %s\n\n    \"signing_public_key\": \"%s\"\n\n  %s\n", Lang::t('cli.key_written', $out), $pair['public'], Lang::t('cli.key_next'));
    exit(0);
}

if ($command === 'verify') {
    $signaturePath = $argv[2] ?? '';
    $declarePath = null;
    foreach (\array_slice($argv, 3) as $arg) {
        if (preg_match('/^--declare=(.+)$/', $arg, $m) === 1) {
            $declarePath = $m[1];
        }
    }
    if (!is_file($signaturePath)) {
        fwrite(\STDERR, '✗ '.Lang::t('cli.verify_usage')."\n");
        exit(1);
    }

    $block = Value::map(json_decode((string) file_get_contents($signaturePath), true));
    $expectedKey = $declarePath !== null ? Declaration::load($declarePath)->signingPublicKey : null;
    $result = Signature::verify([
        'algorithm' => Value::string($block['algorithm'] ?? null),
        'digest' => Value::string($block['digest'] ?? null),
        'signed_at' => Value::string($block['signed_at'] ?? null),
        'public_key' => Value::string($block['public_key'] ?? null),
        'signature' => Value::string($block['signature'] ?? null),
    ], null, $expectedKey);

    printf("  %s\n", Lang::t($result['reason']));
    exit($result['valid'] ? 0 : 1);
}

// --- accept a finding: bin/sablier accept <fingerprint> -----------------
// The command-line twin of the report's button. It writes a decision into a
// versioned file, which is what makes it reviewable; it never hides anything.
if ($command === 'accept') {
    $fingerprint = $argv[2] ?? '';
    $reason = '';
    $until = (new \DateTimeImmutable('+6 months'))->format('Y-m-d');
    $file = 'sablier.json';
    foreach (\array_slice($argv, 3) as $arg) {
        if (preg_match('/^--(reason|until|declare)=(.+)$/', $arg, $m) === 1) {
            ${$m[1] === 'declare' ? 'file' : $m[1]} = $m[2];
        }
    }

    if (preg_match('/^[0-9a-f]{8}$/', $fingerprint) !== 1 || trim($reason) === '') {
        fwrite(\STDERR, '✗ '.Lang::t('cli.accept_usage')."\n");
        exit(1);
    }
    if (\DateTimeImmutable::createFromFormat('Y-m-d', $until) === false) {
        fwrite(\STDERR, '✗ '.Lang::t('cli.accept_bad_date')."\n");
        exit(1);
    }

    $data = is_file($file) ? json_decode((string) file_get_contents($file), true) : [];
    if (!\is_array($data)) {
        fwrite(\STDERR, '✗ '.Lang::t('cli.accept_unreadable', $file)."\n");
        exit(1);
    }
    $accepted = Value::map($data['accepted'] ?? null);
    $accepted[$fingerprint] = ['reason' => trim($reason), 'until' => $until];
    $data['accepted'] = $accepted;
    file_put_contents($file, json_encode($data, \JSON_PRETTY_PRINT | \JSON_UNESCAPED_UNICODE | \JSON_UNESCAPED_SLASHES)."\n");

    printf("  %s\n", Lang::t('cli.accept_written', $fingerprint, $until, $file));
    exit(0);
}

// --- probe only: bin/sablier probe example.org --------------------------
if ($command === 'probe') {
    $target = $argv[2] ?? null;
    if ($target === null) {
        fwrite(\STDERR, '✗ '.Lang::t('cli.missing_host')."\n");
        exit(1);
    }
    $result = (new Probe())->run($target);
    printf("\n  %s\n\n", $target);
    foreach ($result['facts'] as $key => $value) {
        // mb_str_pad: printf counts bytes, so accents would shift the column.
        printf("    %s %s\n", mb_str_pad((string) $key, 28), $value);
    }
    foreach ($result['notes'] as $note) {
        printf("\n    ⚠ %s\n", wordwrap($note, 88, "\n      "));
    }
    foreach ($result['findings'] as $finding) {
        printf("\n    · %s — %s\n", Catalogue::label($finding->algorithm), $finding->detail);
    }
    echo "\n";
    exit(0);
}

// Past this point, two commands share one body: `scan` builds the inventory by
// reading a project, `judge` reads one somebody else's tool produced. Everything
// after the inventory — the risk model, the report, the baseline, the exit code
// — is the same, and that is the whole argument for the import.
if (!\in_array($command, ['scan', 'judge'], true)) {
    fwrite(\STDOUT, Lang::t('cli.usage')."\n");
    exit($command === 'help' ? 0 : 1);
}

$target = null;
$options = ['declare' => null, 'out' => 'report.html', 'json' => null, 'cbom' => null, 'audit' => null, 'pdf' => null, 'year' => null, 'sign' => null, 'baseline' => null, 'quiet' => false, 'no-probe' => false];
foreach (\array_slice($argv, 2) as $arg) {
    if ($arg === '--quiet' || $arg === '--no-probe') {
        $options[substr($arg, 2)] = true;
    } elseif (preg_match('/^--(declare|out|json|cbom|audit|pdf|year|sign|baseline)=(.+)$/', $arg, $m) === 1) {
        $options[$m[1]] = $m[2];
    } elseif (!str_starts_with($arg, '--')) {
        $target = $arg;
    }
}

if ($target === null || ($command === 'scan' ? !is_dir($target) : !is_file($target))) {
    fwrite(\STDERR, '✗ '.Lang::t($command === 'scan' ? 'cli.missing_path' : 'cli.missing_cbom')."\n");
    exit(1);
}

// A scanned project carries its declaration; an imported CBOM has none of its
// own, so the declaration is the one in the hand that runs the command.
$declarationPath = $options['declare'] ?? match (true) {
    $command === 'scan' && is_file($target.'/sablier.json') => $target.'/sablier.json',
    $command === 'judge' && is_file('sablier.json') => 'sablier.json',
    default => null,
};
$declaration = Declaration::load($declarationPath);
// --year projects the same codebase into a future year. The expiry date does
// not move — it is a regulatory deadline — but the other side of the comparison
// does: every year that passes pushes more data over the line. Worth being able
// to show, and worth marking loudly so a projection is never read as a finding.
$actualYear = (int) date('Y');
$currentYear = $options['year'] !== null ? (int) $options['year'] : $actualYear;

$startedAt = microtime(true);

$probes = [];
$importedFrom = '';
if ($command === 'scan') {
    // Composition happens here and nowhere else: the scanner receives what it
    // must run, instead of knowing the list itself.
    $scan = (new Scanner([
        new PhpDetector(),
        new ShellDetector(),
        new KeyMaterialDetector(),
        new ServerConfigDetector(),
        new SshConfigDetector(),
        new EnvDetector(),
        new FrameworkConfigDetector(),
        new SymfonyVaultDetector(),
        new DependencyDetector(),
    ], $declaration->exclude))->scan($target);

    // Live probes come from the declaration: what a server negotiates belongs
    // to the same inventory as what the code says, and it is the only part a
    // file can contradict.
    $probeFindings = [];
    if (!$options['no-probe']) {
        foreach ($declaration->probe as $host) {
            $result = (new Probe())->run($host);
            $probes[] = ['target' => $host, 'facts' => $result['facts'], 'notes' => $result['notes']];
            $probeFindings = [...$probeFindings, ...$result['findings']];
        }
    }

    $inventory = [...$scan['findings'], ...$probeFindings];
    $filesRead = $scan['files'];
    $blind = $scan['blind'];
    $label = $target;
} else {
    // Somebody else's inventory. We judge it; we did not detect it, and the
    // report says so rather than borrowing the credit — along with what the
    // import could not understand, which is the part a silent importer hides.
    $imported = Cbom::read($target);
    if ($imported === null) {
        fwrite(\STDERR, '✗ '.Lang::t('cbom.unreadable', $target)."\n");
        exit(1);
    }

    $inventory = $imported['findings'];
    $filesRead = $imported['locations'];
    $label = $imported['project'];
    $importedFrom = $imported['producer'];
    $blind = [Lang::t('cbom.blind.imported', \count($inventory), $imported['producer'])];
    if ($imported['ignored'] !== []) {
        $names = array_slice(array_values(array_unique($imported['ignored'])), 0, 8);
        $blind[] = Lang::t('cbom.blind.ignored', \count($imported['ignored']), implode(', ', $names));
    }
    if ($imported['unplaced'] > 0) {
        $blind[] = Lang::t('cbom.blind.no_location', $imported['unplaced']);
    }
}

$findings = (new Assessor($declaration, $currentYear))->assess($inventory);
$duration = microtime(true) - $startedAt;

// Signing happens after the analysis and over the findings, never over the
// rendered file: two runs of the same inventory differ byte for byte and say
// exactly the same thing.
$signature = null;
if ($options['sign'] !== null) {
    if (!is_file($options['sign'])) {
        fwrite(\STDERR, '✗ '.Lang::t('cli.key_missing', $options['sign'])."\n");
        exit(1);
    }
    $preliminary = new Analysis($findings, $declaration, $label, $filesRead, $blind, $currentYear);
    $signature = Signature::sign(Signature::digest($preliminary), trim((string) file_get_contents($options['sign'])));
    file_put_contents($options['out'].'.sig', json_encode($signature, \JSON_PRETTY_PRINT | \JSON_UNESCAPED_SLASHES)."\n");
}

$analysis = new Analysis(
    findings: $findings,
    declaration: $declaration,
    target: $label,
    filesRead: $filesRead,
    blindSpots: $blind,
    currentYear: $currentYear,
    duration: $duration,
    probes: $probes,
    projected: $currentYear !== $actualYear,
    signature: $signature,
    importedFrom: $importedFrom,
    // Printed in the audit report: a document that cannot be reproduced is an
    // assertion, not a finding.
    commandLine: implode(' ', array_map(
        static fn (string $argument): string => str_contains($argument, ' ') ? '"'.$argument.'"' : $argument,
        $argv,
    )),
);

file_put_contents($options['out'], (new HtmlReporter())->render($analysis));

if ($options['json'] !== null) {
    file_put_contents($options['json'], (new JsonReporter())->render($analysis));
}

// The inventory in the format other tools read. The house JSON stays for our
// own baseline; this one is for everybody else's pipeline.
if ($options['cbom'] !== null) {
    file_put_contents($options['cbom'], (new CbomReporter())->render($analysis)."\n");
}

// The same analysis, written for whoever has to weigh it rather than act on
// it. A second document rather than a mode of the first: they are read by
// different people, in different rooms.
if ($options['audit'] !== null) {
    file_put_contents($options['audit'], (new AuditReporter())->render($analysis));
}

$pdfMessage = null;
$auditPdfMessage = null;
if ($options['pdf'] !== null) {
    [, $pdfMessage] = Pdf::render($options['out'], $options['pdf']);
    // The audit document is the one that gets printed, signed and filed, so
    // asking for a PDF asks for both. Its name is the audit file's, which is
    // predictable enough not to need an option of its own.
    if ($options['audit'] !== null) {
        $auditPdf = preg_replace('/\.html?$/i', '', $options['audit']).'.pdf';
        [, $auditPdfMessage] = Pdf::render($options['audit'], $auditPdf);
    }
}

$counts = [];
foreach ($findings as $finding) {
    $counts[$finding->verdict] = ($counts[$finding->verdict] ?? 0) + 1;
}

// --- what changed since the reference run --------------------------------
// The exit code is decided here, before anything is printed, because --quiet
// exists for pipelines: a step that stays silent must still be able to stop
// the build.
$diff = null;
if ($options['baseline'] !== null) {
    $baseline = Baseline::load($options['baseline']);
    if ($baseline === null) {
        fwrite(\STDERR, '✗ '.Lang::t('diff.missing', $options['baseline'], $options['baseline'])."\n");
        exit(1);
    }
    $diff = $baseline->compare($findings);
}

$status = $diff !== null
    ? ($diff['decisions'] > 0 ? 2 : 0)
    : (($counts[Assessor::COMPROMISED] ?? 0) > 0 ? 2 : 0);

// Columns are padded to the widest entry of this run rather than to a fixed
// guess: verdict labels differ by language, and a ragged list of findings is
// read as a dump instead of a table.
$verdictText = static fn (Finding $finding, string $from): string => ($from === '' ? '' : Assessor::label($from).' → ').Assessor::label($finding->verdict);
$width = ['verdict' => 0, 'algorithm' => 0];
if ($diff !== null) {
    $entries = [...array_map(static fn (Finding $f): array => [$f, ''], $diff['new']),
        ...array_map(static fn (array $c): array => [$c['finding'], $c['from']], $diff['worsened']),
        ...array_map(static fn (Finding $f): array => [$f, ''], $diff['red'])];
    foreach ($entries as [$finding, $from]) {
        $width['verdict'] = max($width['verdict'], mb_strlen($verdictText($finding, $from)));
        $width['algorithm'] = max($width['algorithm'], mb_strlen($finding->algorithm));
    }
}

/** One line per finding: its fingerprint first, because that is what you type next. */
$line = static function (Finding $finding, string $from = '') use ($verdictText, $width): string {
    return \sprintf(
        "        %s  %s  %s  %s\n",
        $finding->fingerprint(),
        mb_str_pad($verdictText($finding, $from), $width['verdict']),
        mb_str_pad($finding->algorithm, $width['algorithm']),
        $finding->file.($finding->line > 0 ? ':'.$finding->line : ''),
    );
};

$verdictLine = static function (?array $diff): void {
    if ($diff === null) {
        return;
    }
    echo $diff['decisions'] > 0
        ? \sprintf("  ✗ %s\n     %s\n\n", Lang::t('diff.stop', Value::int($diff['decisions'])), Lang::t('diff.how'))
        : \sprintf("  ✓ %s\n\n", Lang::t('diff.go'));
};

if ($options['quiet']) {
    if ($pdfMessage !== null) {
        printf("  %s\n", $pdfMessage);
    }
    $verdictLine($diff);
    exit($status);
}

$sourceLabel = $importedFrom !== ''
    ? Lang::t('report.imported_from', $importedFrom, $filesRead)
    : Lang::t('report.files_read', $filesRead);
printf("\n  %s — %s, %s, %.1f s\n", $label, $sourceLabel, Lang::t('cli.findings', \count($findings)), $duration);
// The colon belongs to the label: French puts a space before it, English does not.
printf("  %s %s\n\n", Lang::t('cli.declaration'), $declarationPath ?? Lang::t('cli.no_declaration'));
foreach (Assessor::order() as $verdict) {
    if (isset($counts[$verdict])) {
        printf("    %s %d\n", mb_str_pad(Assessor::label($verdict), 24), $counts[$verdict]);
    }
}
printf("\n  → %s\n", $options['out']);
if ($options['cbom'] !== null) {
    printf("  → %s\n", $options['cbom']);
}
if ($options['audit'] !== null) {
    printf("  → %s\n", $options['audit']);
}
if ($auditPdfMessage !== null) {
    printf("  → %s\n", $auditPdfMessage);
}
if ($pdfMessage !== null) {
    printf("  → %s\n", $pdfMessage);
}
if ($signature !== null) {
    printf("  → %s\n", Lang::t('cli.signed', $options['out'].'.sig'));
}
echo "\n";

if ($diff !== null) {
    printf("  %s\n", Lang::t('diff.header', $options['baseline'], $baseline->count()));
    if ($diff['new'] !== [] || $diff['worsened'] !== [] || $diff['red'] !== [] || $diff['resolved'] !== []) {
        echo "\n";
    }
    if ($diff['new'] !== []) {
        printf("    + %s\n", Lang::t('diff.new', \count($diff['new'])));
        foreach ($diff['new'] as $finding) {
            echo $line($finding);
        }
    }
    if ($diff['worsened'] !== []) {
        printf("    ↑ %s\n", Lang::t('diff.worse', \count($diff['worsened'])));
        foreach ($diff['worsened'] as $change) {
            echo $line($change['finding'], $change['from']);
        }
    }
    if ($diff['red'] !== []) {
        printf("    ● %s\n", Lang::t('diff.red', \count($diff['red'])));
        foreach ($diff['red'] as $finding) {
            echo $line($finding);
        }
    }
    if ($diff['resolved'] !== []) {
        printf("    − %s\n", Lang::t('diff.gone', \count($diff['resolved'])));
    }
    echo "\n";
}

$verdictLine($diff);

// Non-zero exit when a decision is due: a new finding, a verdict that got
// worse, a red finding nobody has decided on — or, with no reference to
// compare against, long-lived data already exposed. That is what makes this
// usable as a pipeline step.
exit($status);
