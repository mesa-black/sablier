{
  "project": "Show me the REX",
  "expiry_year": 2035,
  "default_lifetime_years": 3,
  "domains": {
    "public content": {
      "paths": [
        "src/Entity/Feedback*",
        "templates/*",
        "src/Controller/Public*"
      ],
      "lifetime_years": 0,
      "note": "Case studies are published: their confidentiality has no duration to protect."
    },
    "accounting": {
      "paths": [
        "src/Billing/*",
        "src/Entity/Invoice*",
        "src/Entity/Subscription*"
      ],
      "lifetime_years": 10,
      "note": "Accounting records: ten years of legal retention."
    },
    "authentication": {
      "paths": [
        "src/Security/*",
        "src/Entity/Credential*",
        "src/Entity/User*",
        "config/packages/security.yaml"
      ],
      "lifetime_years": 3,
      "note": "Authentication secrets, on a reasonable rotation."
    },
    "transport and session": {
      "paths": [
        "Caddyfile",
        "*.conf",
        "config/packages/framework.yaml",
        "tls://*"
      ],
      "lifetime_years": 1
    },
    "declared dependencies": {
      "paths": [
        "composer.lock",
        "package-lock.json"
      ],
      "lifetime_years": 0,
      "note": "Inventory, not usage: the lifetime does not apply here."
    }
  },
  "probe": [
    "showmetherex.com"
  ]
}
