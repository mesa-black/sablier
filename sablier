#!/bin/sh
# Sablier, with the PHP that is on this machine — or with one borrowed.
#
# The tool has no dependencies, which is the point; but PHP 8.4 is itself a
# dependency, and a consultant running an audit on a client's laptop may not
# have it. So: use the local interpreter when it is recent enough, and when it
# is not, run the same code inside the official PHP image. Nothing is
# installed, nothing is written outside the current directory, and the analysis
# is identical either way — the tool reads files and opens TLS sockets, both of
# which a container does as well as a host.
#
# Paths are resolved against the current directory, which is what the container
# sees. Scanning a project elsewhere means standing in it:
#   cd /path/to/project && /path/to/sablier scan .
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
# Alpine rather than the Debian image, for one measurable reason: at the time
# of writing Trivy reports 162 high or critical vulnerabilities in php:8.4-cli
# and none in this one. `make cve` re-checks that claim rather than trusting it.
#
# Pinned by digest, and not by tag, because a tag is a pointer somebody else
# moves. `php:8.5-cli-alpine` meant different bytes last month and will mean
# different bytes next month, so a launcher that names the tag runs code nobody
# in this repository has checked — while the Makefile beside it pins the very
# same image by digest. That inconsistency is the shape of the failure this
# project has already written up elsewhere: a minor base-image release that
# removed a directive and stopped shipping a directory, surfacing as an exit code
# everybody reads as something else.
#
# The digest is the same string as PHP_IMAGE in the Makefile, and the test suite
# refuses a commit where the two disagree. `make images` prints what the tag
# resolves to today, for updating it on purpose.
image=${SABLIER_PHP_IMAGE:-php:8.5-cli-alpine@sha256:d1fbbe78850d1eb9aa8f7da652ec5db61eb4c9377c8215cf5e23f3b528ed4f2b}

if command -v php >/dev/null 2>&1 && php -r 'exit(PHP_VERSION_ID >= 80400 ? 0 : 1);' 2>/dev/null; then
    exec php "$root/bin/sablier" "$@"
fi

if ! command -v docker >/dev/null 2>&1; then
    echo "sablier: needs PHP 8.4 or Docker, and found neither." >&2
    echo "         PHP: https://www.php.net/downloads — Docker: https://docs.docker.com/get-docker/" >&2
    exit 1
fi

# A path outside the mounted directory would be written inside the container
# and lost with it. Saying so beats a report that silently goes nowhere.
for argument in "$@"; do
    case "$argument" in
        --*=/*) candidate=${argument#*=} ;;
        /*) candidate=$argument ;;
        *) continue ;;
    esac
    case "$candidate" in
        "$PWD"|"$PWD"/*) ;;
        *)
            echo "sablier: without a local PHP, every path must sit inside $PWD." >&2
            echo "         $candidate does not. Run the command from the directory that holds it." >&2
            exit 1
            ;;
    esac
done

# `serve` is a web server, and a container's loopback is not this machine's. Its
# port is published on the address --host names here (the loopback unless told
# otherwise), and the server inside listens on every interface of the container
# so the published port reaches it: --host keeps its meaning, and the token with
# it. --init, because Ctrl-C has to stop it: PID 1 ignores a signal it set no
# handler for, so without an init in front the server would outlive the keypress.
publish=
if [ "${1:-}" = serve ]; then
    port=8765
    host=127.0.0.1
    # The same shapes bin/sablier accepts, and the same fallback when a value
    # does not have one: it ignores the flag, so the default stands here too.
    for argument in "$@"; do
        case "$argument" in
            --port= | --port=? | --port=??????* | --port=*[!0-9]*) ;;
            --port=*) port=${argument#--port=} ;;
            --host=*[!0-9a-fA-F.:]* | --host=) ;;
            --host=*) host=${argument#--host=} ;;
        esac
    done
    case "$host" in
        *:*) host="[$host]" ;;
    esac
    publish="--init --env SABLIER_LISTEN=0.0.0.0 --publish $host:$port:$port"
fi

# `declare` is an interview: it reads its answers on standard input. Without -i
# the container's stdin is closed, every question reads end-of-file and the whole
# interview is recorded as skipped, in zero seconds, with exit 0. So stdin is
# always attached, which also lets answers be piped in; and a terminal is
# allocated only when there is one on both ends, because -t on a pipe fails.
interactive=-i
if [ -t 0 ] && [ -t 1 ]; then
    interactive=-it
fi

# --user keeps the report owned by whoever ran the command rather than by root;
# the repository is mounted read-only because the tool never writes into itself.
# $publish is unquoted on purpose: empty, it has to vanish rather than pass "".
# shellcheck disable=SC2086
exec docker run --rm $interactive $publish \
    --user "$(id -u):$(id -g)" \
    --volume "$root":/sablier:ro \
    --volume "$PWD":/work \
    --workdir /work \
    --env SABLIER_LANG \
    "$image" php /sablier/bin/sablier "$@"
